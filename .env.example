# ============================================================
# Gavelhouse -- Root .env.example
# Copy values into the appropriate location (see comments).
# NEVER commit a .env file with real secrets.
# ============================================================


# ------------------------------------------------------------
# Database (apps/api -- Neon Postgres via Cloudflare Hyperdrive)
# ------------------------------------------------------------
DATABASE_URL=          # Neon main branch pooled connection string (postgresql://...pooler...neon.tech/neondb?sslmode=require)
DATABASE_URL_DEV=      # Neon dev branch pooled connection string


# ------------------------------------------------------------
# Auth (apps/api -- Better Auth)
# ------------------------------------------------------------
BETTER_AUTH_SECRET=    # Random 32-char secret; generate with: openssl rand -base64 32
BETTER_AUTH_URL=       # Base URL of the API, e.g. https://api.gavelhouse.app (or http://localhost:8060 locally)


# ------------------------------------------------------------
# Google OAuth (apps/api -- Better Auth Google provider)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=      # OAuth 2.0 client ID from Google Cloud Console
GOOGLE_CLIENT_SECRET=  # OAuth 2.0 client secret from Google Cloud Console


# ------------------------------------------------------------
# Stripe (apps/api -- subscription billing)
# ------------------------------------------------------------
STRIPE_SECRET_KEY=             # Restricted API key from Stripe dashboard (sk_live_... or sk_test_...)
STRIPE_WEBHOOK_SECRET=         # Webhook signing secret from Stripe endpoint (whsec_...)

# Price IDs -- Starter tier
STRIPE_PRICE_STARTER_MONTHLY=  # price_... for $59/mo
STRIPE_PRICE_STARTER_ANNUAL=   # price_... for $588/yr ($49/mo effective)

# Price IDs -- Growth tier
STRIPE_PRICE_GROWTH_MONTHLY=   # price_... for $165/mo
STRIPE_PRICE_GROWTH_ANNUAL=

# Price IDs -- Scale tier
STRIPE_PRICE_SCALE_MONTHLY=    # price_... for $299/mo
STRIPE_PRICE_SCALE_ANNUAL=     # price_... for $2,988/yr ($249/mo effective)

# Portfolio is custom and has no Stripe price ID.

# Subscription offer coupon IDs are fixed in Stripe:
# M80OFF = monthly-plan code for 80% off the first year, limit 100.
# Y80OFF = yearly-plan code for 80% off the first year, limit 200.


# ------------------------------------------------------------
# Email (apps/api -- Resend)
# ------------------------------------------------------------
RESEND_API_KEY=        # API key from Resend dashboard (re_...)
RESEND_FROM_ADDRESS=Angel Campa <angel.campa@gavelhouse.app>  # Verified sender identity in Resend
RESEND_REPLY_TO_EMAIL=angel.campa@gavelhouse.app              # Reply-to address for outbound emails
LEAD_MAGNET_DOWNLOAD_SECRET= # Random HMAC secret for signed lead magnet PDF URLs; set as a Cloudflare Worker secret
AI_CS_CLIENT_ASSERTION_SECRET= # HMAC secret for authenticated AI-CS Worker proxy requests; set as a Cloudflare Worker secret


# ------------------------------------------------------------
# Lead magnet resources (apps/web deploy -> Cloudflare R2)
# ------------------------------------------------------------
LEAD_MAGNET_R2_BUCKET=boardstack-lead-magnets # Override only for non-production R2 upload/verify runs


# ------------------------------------------------------------
# Observability -- API (apps/api -- Sentry for Cloudflare Workers)
# ------------------------------------------------------------
SENTRY_DSN=            # DSN from Sentry project: boardstack-api
SENTRY_ENVIRONMENT=    # API Sentry environment, e.g. production/staging
SENTRY_RELEASE=        # API release name, usually commit SHA or app@sha


# ------------------------------------------------------------
# Observability -- App (apps/app -- Vite dashboard SPA)
# ------------------------------------------------------------
VITE_SENTRY_DSN=       # DSN from Sentry project: boardstack-app
VITE_SENTRY_ENVIRONMENT= # App Sentry environment, e.g. production/staging
VITE_SENTRY_RELEASE=   # App release name used for source map resolution
VITE_POSTHOG_KEY=      # PostHog project API key (phc_...)
VITE_POSTHOG_HOST=https://us.i.posthog.com # PostHog ingest host


# ------------------------------------------------------------
# Ventora CRM feedback widget (apps/app -- central feedback inbox)
# ------------------------------------------------------------
VITE_CRM_WIDGET_KEY=   # CRM-issued widget public key, per product. Blank disables the widget.
VITE_CRM_LOADER_URL=https://crm.ventoralabs.com/w/v1.js # Ventora CRM widget loader script


# ------------------------------------------------------------
# Observability -- Web (apps/web -- Astro marketing site)
# ------------------------------------------------------------
PUBLIC_SENTRY_DSN=     # DSN from Sentry project: boardstack-web (if separate) or boardstack-app
PUBLIC_SENTRY_ENVIRONMENT= # Web Sentry environment, e.g. production/staging
PUBLIC_SENTRY_RELEASE= # Web release name used for source map resolution
SENTRY_AUTH_TOKEN=     # Sentry auth token with project:releases access
SENTRY_ORG=            # Sentry organization slug
SENTRY_PROJECT=        # Sentry project slug for the package being built
PUBLIC_POSTHOG_KEY=    # PostHog project API key (phc_...) -- same value as VITE_POSTHOG_KEY
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com # PostHog ingest host -- same value as VITE_POSTHOG_HOST


# ------------------------------------------------------------
# URLs (local development defaults -- override in CI/production)
# ------------------------------------------------------------
VITE_API_URL=http://localhost:8060    # API base URL consumed by apps/app
PUBLIC_API_URL=http://localhost:8060  # API base URL consumed by apps/web
PUBLIC_APP_URL=http://localhost:3060  # Dashboard SPA URL consumed by apps/web
