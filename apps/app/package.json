{
  "name": "@boardstack/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3060",
    "build": "pnpm exec tsx ./scripts/assert-build-env.ts && vite build",
    "preview": "vite preview --port 3060",
    "deploy": "node ../../scripts/run-deploy-sequence.mjs app",
    "deploy:upload": "wrangler deploy",
    "lint": "pnpm exec eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --grep-invert \"screenshot archive\"",
    "e2e:capture": "playwright test capture-",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@boardstack/design": "workspace:*",
    "@boardstack/shared": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.48.0",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "@tanstack/router-devtools": "^1.166.13",
    "@ventora/ai-cs": "workspace:*",
    "better-auth": "^1.6.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "posthog-js": "^1.369.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.72.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^5.2.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/router-plugin": "^1.167.22",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.3",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "^5.7",
    "vite": "^6",
    "vitest": "^4.1.3",
    "wrangler": "^4.85.0"
  }
}
