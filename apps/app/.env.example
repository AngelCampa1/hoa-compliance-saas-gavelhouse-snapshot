VITE_API_URL=http://localhost:8060

# Production builds set this to "true" so the retired app serves only a closure
# notice. Leave it false locally to boot the real dashboard.
VITE_GAVELHOUSE_SHUTDOWN=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Ventora CRM feedback widget — CRM-issued widget public key, per product.
# Blank disables the widget (graceful degradation in CI/preview).
VITE_CRM_WIDGET_ENABLED=false
VITE_CRM_WIDGET_KEY=
VITE_CRM_LOADER_URL=https://crm.ventoralabs.com/w/v1.js
