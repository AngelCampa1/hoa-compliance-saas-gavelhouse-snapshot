---
import {
  resolveOgImage,
  truncateMetaTitle,
  truncateMetaDescription,
} from "../lib/meta";
import { BRAND_TWITTER_HANDLE } from "@boardstack/shared";

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  siteName: string;
  publishedAt?: string;
  updatedAt?: string;
  noindex?: boolean;
  ogType?: string;
  twitterSite?: string;
  articleAuthor?: string;
  articleSection?: string;
  articleTags?: string[];
  siteUrl?: string;
  preserveAuthoredMetadata?: boolean;
}
const {
  title,
  description,
  canonicalUrl,
  ogImage: ogImageProp,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt,
  siteName,
  publishedAt,
  updatedAt,
  noindex = false,
  ogType = "website",
  twitterSite = BRAND_TWITTER_HANDLE,
  articleAuthor,
  articleSection,
  articleTags,
  siteUrl,
  preserveAuthoredMetadata = false,
} = Astro.props;
const ogImage = resolveOgImage(canonicalUrl, ogImageProp, siteUrl);
const metaTitle = preserveAuthoredMetadata ? title : truncateMetaTitle(title);
const metaDescription = preserveAuthoredMetadata
  ? description
  : truncateMetaDescription(description);
---

<title>{metaTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonicalUrl} />
<meta
  name="robots"
  content={noindex
    ? "noindex, follow"
    : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
/>

<meta property="og:title" content={metaTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
{
  /* intentionally untruncated: alt text is for accessibility, not SERP display */
}
<meta property="og:image:alt" content={ogImageAlt ?? description} />
{
  publishedAt && (
    <meta property="article:published_time" content={publishedAt} />
  )
}
{updatedAt && <meta property="article:modified_time" content={updatedAt} />}
{articleAuthor && <meta property="article:author" content={articleAuthor} />}
{articleSection && <meta property="article:section" content={articleSection} />}
{articleTags?.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={metaTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{
  /* intentionally untruncated: alt text is for accessibility, not SERP display */
}
<meta name="twitter:image:alt" content={ogImageAlt ?? description} />
