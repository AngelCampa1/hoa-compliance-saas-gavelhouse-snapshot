---
import BaseLayout from "./base-layout.astro";
import BreadcrumbNav from "../components/breadcrumb-nav.astro";
import BlufBlock from "../seo/bluf-block.astro";
import SchemaMarkup from "../seo/schema-markup.astro";
import {
  buildArticleSchema,
  buildItemListSchema,
  buildPageIdentityGraphSchemas,
  mergeFaqSources,
} from "../lib/schema-builders";
import { buildGraph, withId } from "../lib/schema-graph";
import {
  resolveSchemaImage,
  buyerStageToSection,
  ensureTrailingSlash,
} from "../lib/meta";
import SiteHeader from "../components/site-header.astro";
import ArticleMeta from "../components/article-meta.astro";
import SiteFooter from "../components/site-footer.astro";
import TableOfContents from "../components/table-of-contents.astro";
import SourcesSection from "../components/sources-section.astro";
import ResourceHubLinks from "../components/resource-hub-links.astro";
import { ExitIntentPopup } from "../components/exit-intent-popup";
import { resolveExitPopupProps } from "../lib/exit-popup-props";
import { resolvePublicApiUrl } from "../lib/public-runtime-urls";
import type {
  SiteConfig,
  BuyerStage,
  FaqItem,
  ContentSource,
  LeadMagnet,
} from "../lib/types";

interface ToolItem {
  name: string;
  summary: string;
}

interface Props {
  title: string;
  description: string;
  bluf: string;
  buyerStage?: BuyerStage;
  publishedAt: string;
  updatedAt: string;
  reviewedAt?: string;
  canonicalPath: string;
  config: SiteConfig;
  breadcrumbs: { label: string; href: string }[];
  tools: ToolItem[];
  schemas?: Record<string, unknown>[];
  headings?: { depth: number; slug: string; text: string }[];
  ogImage?: string;
  noindex?: boolean;
  answers?: { question: string; answer: string }[];
  faqs?: FaqItem[];
  tags?: string[];
  sources?: ContentSource[];
  leadMagnetOverride?: LeadMagnet;
}
const {
  title,
  description,
  bluf,
  buyerStage,
  publishedAt,
  updatedAt,
  reviewedAt,
  canonicalPath,
  config,
  breadcrumbs,
  tools,
  schemas = [],
  headings,
  ogImage,
  noindex,
  answers = [],
  faqs = [],
  tags,
  sources = [],
  leadMagnetOverride,
} = Astro.props;
const exitPopupProps =
  config.exitPopup?.enabled !== false
    ? resolveExitPopupProps(config)
    : undefined;
const publicApiUrl = resolvePublicApiUrl(import.meta.env.PUBLIC_API_URL);
const canonicalUrl = ensureTrailingSlash(
  `https://${config.domain}${canonicalPath}`,
);

const siteUrl = `https://${config.domain}`;
const orgId = `${siteUrl}/#organization`;
const identitySchemas = buildPageIdentityGraphSchemas({
  siteName: config.name,
  siteUrl,
  pageUrl: canonicalUrl,
  pageName: title,
  pageDescription: description,
  breadcrumbs,
  author: config.author,
  logo: config.logo?.light,
  sameAs: config.sameAs,
  contactEmail: config.contactEmail,
  areaServed: config.areaServed,
  searchPathTemplate: config.searchPathTemplate,
});
const articleSchema = buildArticleSchema({
  headline: title,
  description,
  datePublished: publishedAt,
  dateModified: updatedAt,
  lastReviewed: reviewedAt ?? updatedAt,
  publisher: { "@id": orgId },
  author: config.author,
  image: resolveSchemaImage(config.domain, ogImage, config.defaultOgImage),
  mainEntityOfPage: canonicalUrl,
  speakableCssSelectors: [".bluf-block", ".faq-answer", ".answer-block-answer"],
});

const itemListSchema = buildItemListSchema(
  tools.map((t) => ({ name: t.name, description: t.summary })),
);
const faqSchema = mergeFaqSources(faqs, answers);
const articleId = `${canonicalUrl}#article`;
const graph = buildGraph([
  ...identitySchemas,
  withId(articleSchema, articleId),
  itemListSchema,
  ...schemas,
  ...(faqSchema ? [faqSchema] : []),
]);
---

<BaseLayout
  title={`${title} | ${config.name}`}
  description={description}
  canonicalUrl={canonicalUrl}
  siteName={config.name}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  twitterSite={config.social?.twitterHandle}
  articleAuthor={config.author?.name}
  themeColor={config.theme.primary}
  ogImage={ogImage}
  noindex={noindex}
  theme={config.theme}
  fonts={config.theme.fonts}
  preserveMetaTagCopy={config.preserveMetaTagCopy}
  appleTouchIcon={config.appleTouchIcon}
  rssUrl="/rss.xml"
  siteUrl={`https://${config.domain}`}
  analyticsEnabled={config.analytics?.enabled ?? true}
  enableScrollReveal={false}
  articleSection={buyerStage ? buyerStageToSection(buyerStage) : undefined}
  articleTags={tags}
>
  <SiteHeader
    slot="header"
    siteName={config.name}
    navItems={config.nav?.items}
    ctaText={config.funnel.bofu.ctaText}
    ctaHref={config.funnel.bofu.ctaTarget}
    ctaVariant="primary"
  />
  <div
    data-editorial-layout
    class="article-page-shell editorial-shell mx-auto max-w-6xl px-4 py-[var(--section-py)]"
  >
    <div
      data-editorial-article
      class="article-page-intro relative overflow-hidden rounded-[var(--r-lg)] border border-[var(--hairline)] bg-[var(--paper-0)] px-5 py-6 shadow-[var(--shadow-1)] sm:px-6 lg:px-8 lg:py-8"
    >
      <BreadcrumbNav
        items={breadcrumbs}
        siteUrl={`https://${config.domain}`}
        emitSchema={false}
      />
      <div
        class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1.16fr)_minmax(14rem,0.58fr)] lg:items-end"
      >
        <div class="relative z-[1] max-w-[var(--content-measure-wide)]">
          <p class="b1-eyebrow">T5 · Listicle</p>
          <h1 class="b1-h1 mt-4">
            {title}
          </h1>
          <ArticleMeta
            authorName={config.author?.name}
            authorTitle={config.author?.title}
            authorUrl={config.author?.url}
            publishedAt={publishedAt}
            updatedAt={updatedAt}
            reviewedAt={reviewedAt}
          />
        </div>
        <div
          class="relative z-[1] max-w-[18rem] rounded-[var(--radius-lg)] border border-[color-mix(in_srgb,var(--color-brand-primary)_14%,var(--color-neutral-300))] bg-[color-mix(in_srgb,var(--surface-elevated)_72%,white)] px-5 py-4 shadow-[var(--shadow-card)]"
        >
          <p class="b1-eyebrow">Scoring rubric</p>
          <div class="score-dots" aria-label="5 criteria, equal weight">
            {
              Array.from({ length: 10 }).map((_, index) => (
                <span class={index < 8 ? "is-on" : ""} />
              ))
            }
          </div>
          <p class="b1-small">5 criteria × 20 pts</p>
        </div>
      </div>
    </div>
    <div
      class:list={[
        "article-page-grid mt-8",
        headings &&
          headings.length > 0 &&
          "lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-12",
      ]}
    >
      <article
        class="article-page-body max-w-[var(--content-measure-wide)] min-w-0 rounded-[calc(var(--radius-xl)+2px)] border border-[color-mix(in_srgb,var(--color-neutral-300)_32%,transparent)] bg-[color-mix(in_srgb,var(--surface-primary)_90%,white)] px-5 py-6 shadow-[var(--shadow-card)] sm:px-6 lg:px-8 lg:py-8"
      >
        <BlufBlock text={bluf} />
        <div
          class="article-prose prose prose-lg max-w-none prose-p:max-w-[var(--content-measure)] prose-li:max-w-[var(--content-measure)]"
        >
          <slot />
        </div>
        <SourcesSection sources={sources} />
      </article>
      {
        headings && headings.length > 0 && (
          <aside
            data-editorial-sidebar
            class="article-page-sidebar mt-8 lg:mt-0"
            aria-label="Table of contents"
          >
            <TableOfContents headings={headings} />
          </aside>
        )
      }
    </div>
  </div>
  <ResourceHubLinks pathname={canonicalPath} />
  <style>
    .article-page-intro {
      isolation: isolate;
    }

    .article-page-intro::before {
      content: "";
      position: absolute;
      inset: auto auto -16% -2%;
      width: 18rem;
      height: 10rem;
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-brand-primary) 12%, transparent),
        transparent
      );
      filter: blur(18px);
      pointer-events: none;
      z-index: 0;
    }
  </style>
  <SchemaMarkup graph={graph} />
  {
    exitPopupProps && (
      <ExitIntentPopup
        client:load
        apiUrl={publicApiUrl}
        siteName={config.name}
        leadMagnet={leadMagnetOverride ?? config.leadMagnet}
        {...exitPopupProps}
      />
    )
  }
  <SiteFooter
    slot="footer"
    siteName={config.name}
    tagline={config.tagline}
    linkGroups={config.footer?.linkGroups}
    legalLinks={config.footer?.legalLinks}
    contactEmail={config.contactEmail}
    captureVariant="none"
    surface="ink"
    colophon="Built in public for self-managed HOA and condo boards. Gavelhouse is an operating tool, not legal advice — consult your state's HOA statute and a licensed attorney for specific obligations."
  />
</BaseLayout>
