---
import BaseLayout from "./base-layout.astro";
import BreadcrumbNav from "../components/breadcrumb-nav.astro";
import BlufBlock from "../seo/bluf-block.astro";
import FunnelCta from "../components/funnel-cta.astro";
import TableOfContents from "../components/table-of-contents.astro";
import SchemaMarkup from "../seo/schema-markup.astro";
import SiteHeader from "../components/site-header.astro";
import SiteFooter from "../components/site-footer.astro";
import { ExitIntentPopup } from "../components/exit-intent-popup";
import { resolveExitPopupProps } from "../lib/exit-popup-props";
import {
  buildArticleSchema,
  buildPageIdentityGraphSchemas,
  mergeFaqSources,
} from "../lib/schema-builders";
import { buildGraph, withId } from "../lib/schema-graph";
import { resolvePublicApiUrl } from "../lib/public-runtime-urls";
import {
  resolveSchemaImage,
  buyerStageToSection,
  ensureTrailingSlash,
} from "../lib/meta";
import { shouldShowToc } from "../lib/headings";
import ArticleMeta from "../components/article-meta.astro";
import SourcesSection from "../components/sources-section.astro";
import EditorialBody from "../components/editorial-body.astro";
import type { TocHeading } from "../lib/headings";
import type {
  SiteConfig,
  BuyerStage,
  FaqItem,
  ContentSource,
  LeadMagnet,
} from "../lib/types";

interface Props {
  title: string;
  description: string;
  bluf: string;
  buyerStage: BuyerStage;
  publishedAt: string;
  updatedAt: string;
  reviewedAt?: string;
  canonicalPath: string;
  config: SiteConfig;
  breadcrumbs: { label: string; href: string }[];
  schemas?: Record<string, unknown>[];
  maxWidth?: string;
  ctaHeading?: string;
  headings?: TocHeading[];
  ogImage?: string;
  noindex?: boolean;
  answers?: { question: string; answer: string }[];
  faqs?: FaqItem[];
  tags?: string[];
  sources?: ContentSource[];
  leadMagnetOverride?: LeadMagnet;
}
const {
  title,
  description,
  bluf,
  buyerStage,
  publishedAt,
  updatedAt,
  reviewedAt,
  canonicalPath,
  config,
  breadcrumbs,
  schemas = [],
  maxWidth = "max-w-3xl",
  ctaHeading,
  headings = [],
  ogImage,
  noindex,
  answers = [],
  faqs = [],
  tags,
  sources = [],
  leadMagnetOverride,
} = Astro.props;
const exitPopupProps =
  config.exitPopup?.enabled !== false
    ? resolveExitPopupProps(config)
    : undefined;
const publicApiUrl = resolvePublicApiUrl(import.meta.env.PUBLIC_API_URL);
const showToc = shouldShowToc(headings);
const canonicalUrl = ensureTrailingSlash(
  `https://${config.domain}${canonicalPath}`,
);

const siteUrl = `https://${config.domain}`;
const orgId = `${siteUrl}/#organization`;
const identitySchemas = buildPageIdentityGraphSchemas({
  siteName: config.name,
  siteUrl,
  pageUrl: canonicalUrl,
  pageName: title,
  pageDescription: description,
  breadcrumbs,
  author: config.author,
  logo: config.logo?.light,
  sameAs: config.sameAs,
  contactEmail: config.contactEmail,
  areaServed: config.areaServed,
  searchPathTemplate: config.searchPathTemplate,
});
const articleSchema = buildArticleSchema({
  headline: title,
  description,
  datePublished: publishedAt,
  dateModified: updatedAt,
  lastReviewed: reviewedAt ?? updatedAt,
  publisher: { "@id": orgId },
  author: config.author,
  image: resolveSchemaImage(config.domain, ogImage, config.defaultOgImage),
  mainEntityOfPage: canonicalUrl,
  speakableCssSelectors: [".bluf-block", ".faq-answer", ".answer-block-answer"],
});
// Merge frontmatter faqs (primary, wins on conflict) with inline AnswerBlock answers (secondary)
const faqSchema = mergeFaqSources(faqs, answers);
const articleId = `${canonicalUrl}#article`;
const graph = buildGraph([
  ...identitySchemas,
  withId(articleSchema, articleId),
  ...schemas,
  ...(faqSchema ? [faqSchema] : []),
]);
---

<BaseLayout
  title={`${title} | ${config.name}`}
  description={description}
  canonicalUrl={canonicalUrl}
  siteName={config.name}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  twitterSite={config.social?.twitterHandle}
  articleAuthor={config.author?.name}
  themeColor={config.theme.primary}
  theme={config.theme}
  fonts={config.theme.fonts}
  preserveMetaTagCopy={config.preserveMetaTagCopy}
  appleTouchIcon={config.appleTouchIcon}
  ogImage={ogImage}
  noindex={noindex}
  siteUrl={`https://${config.domain}`}
  analyticsEnabled={config.analytics?.enabled ?? true}
  enableScrollReveal={false}
  articleSection={buyerStageToSection(buyerStage)}
  articleTags={tags}
  rssUrl="/rss.xml"
>
  <SiteHeader
    slot="header"
    siteName={config.name}
    navItems={config.nav?.items}
    ctaText={config.funnel.bofu.ctaText}
    ctaHref={config.funnel.bofu.ctaTarget}
    ctaVariant="primary"
  />
  <BreadcrumbNav
    items={breadcrumbs}
    siteUrl={`https://${config.domain}`}
    emitSchema={false}
  />
  <div
    data-editorial-layout
    class={`b1-template-article px-4 py-[var(--section-py)] ${maxWidth} mx-auto ${showToc ? "lg:max-w-5xl" : ""}`}
  >
    <EditorialBody proseTypography={false}>
      <article data-editorial-article>
        <h1 class="b1-h1 mb-4">
          {title}
        </h1>
        <aside class="b1-card statute-card">
          <p class="b1-eyebrow">T2 · State page</p>
          <h2 class="b1-h3">Annual compliance calendar</h2>
          <div class="compliance-calendar">
            {
              [
                "Jan",
                "Feb",
                "Mar",
                "Apr",
                "May",
                "Jun",
                "Jul",
                "Aug",
                "Sep",
                "Oct",
                "Nov",
                "Dec",
              ].map((month, index) => (
                <span class={index === 3 || index === 8 ? "is-due" : ""}>
                  {month}
                </span>
              ))
            }
          </div>
          <p class="b1-small">
            Statute cards, deadline badges, and plain-English controls sit
            beside the article body.
          </p>
        </aside>
        <ArticleMeta
          authorName={config.author?.name}
          authorTitle={config.author?.title}
          authorUrl={config.author?.url}
          publishedAt={publishedAt}
          updatedAt={updatedAt}
          reviewedAt={reviewedAt}
        />
        <BlufBlock text={bluf} />
        <div
          class="prose prose-lg max-w-none prose-p:max-w-prose prose-li:max-w-prose"
        >
          <slot />
        </div>
        <SourcesSection sources={sources} />
      </article>
      {
        showToc && (
          <Fragment slot="margin">
            <div data-editorial-sidebar>
              <TableOfContents headings={headings} />
            </div>
          </Fragment>
        )
      }
    </EditorialBody>
  </div>
  <FunnelCta
    stage={buyerStage}
    funnel={config.funnel}
    subtitle={config.funnel.ctaSubtitle}
    heading={ctaHeading}
    trustNote={config.copy?.funnelCta?.trustNote}
    benefitBullets={config.copy?.funnelCta?.benefitBullets}
    secondaryCtaText={config.copy?.funnelCta?.secondaryCta?.text}
    secondaryCtaTarget={config.copy?.funnelCta?.secondaryCta?.target}
  />
  <SchemaMarkup graph={graph} />
  {
    exitPopupProps && (
      <ExitIntentPopup
        client:load
        apiUrl={publicApiUrl}
        siteName={config.name}
        leadMagnet={leadMagnetOverride ?? config.leadMagnet}
        {...exitPopupProps}
      />
    )
  }
  <SiteFooter
    slot="footer"
    siteName={config.name}
    tagline={config.tagline}
    linkGroups={config.footer?.linkGroups}
    legalLinks={config.footer?.legalLinks}
    contactEmail={config.contactEmail}
    captureVariant="none"
    surface="ink"
    colophon="Built in public for self-managed HOA and condo boards. Gavelhouse is an operating tool, not legal advice — consult your state's HOA statute and a licensed attorney for specific obligations."
  />
</BaseLayout>

<style>
  .statute-card {
    margin: 1.5rem 0;
  }

  .compliance-calendar {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
    margin: 14px 0;
  }

  .compliance-calendar span {
    display: grid;
    min-height: 34px;
    place-items: center;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--paper-1);
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 10px;
  }

  .compliance-calendar .is-due {
    border-color: var(--accent);
    background: var(--accent-3);
    color: var(--accent);
    font-weight: 700;
  }
</style>
