---
import { knowledgeBase, NAV_ITEMS } from "@boardstack/shared";
import type { NavItem } from "../lib/types";
import BrandLogoMark from "./brand-logo-mark.astro";

interface Props {
  siteName: string;
  navItems?: NavItem[];
  ctaText?: string;
  ctaHref?: string;
  ctaVariant?: "primary" | "secondary";
  logoWidth?: number;
  mobileCtaEyebrow?: string;
  signInHref?: string;
  signInText?: string;
}

const marketingKnowledge = knowledgeBase.marketing;
const publicAppUrl = new URL(marketingKnowledge.funnel.publicSignupUrl).origin;

const {
  siteName,
  navItems = NAV_ITEMS,
  ctaText = "Start trial",
  ctaHref = marketingKnowledge.funnel.publicSignupUrl,
  signInHref = publicAppUrl,
  signInText = "Log in",
} = Astro.props;

const topLevelLabels = ["Product", "Resources", "Pricing", "About"] as const;
const normalizedNav = navItems.map((item) =>
  item.label === "Features" ? { ...item, label: "Product" } : item,
);
const simpleNav = topLevelLabels.map((label) => {
  const existing = normalizedNav.find((item) => item.label === label);
  if (existing) return existing;
  return {
    label,
    href:
      label === "Product"
        ? "/product/"
        : label === "Resources"
          ? "/resources/"
          : label === "Pricing"
            ? "/pricing/"
            : "/about/",
  };
});
---

<header class="b1-site-nav" data-site-header>
  <div class="b1-site-nav__inner">
    <a class="b1-site-nav__brand" href="/" aria-label={`${siteName} home`}>
      <BrandLogoMark size="sm" />
      <span class="b1-site-nav__wordmark">
        <span>Gavel</span><span>house</span>
      </span>
    </a>

    <nav class="b1-site-nav__links" aria-label="Main navigation">
      {
        simpleNav.map((item) =>
          item.megaMenu ? (
            <div class="b1-site-nav__mega-trigger" data-mega-trigger>
              <button
                class="b1-site-nav__mega-btn"
                aria-expanded="false"
                aria-haspopup="true"
                data-site-nav-link
              >
                {item.label}
                <svg
                  class="b1-site-nav__chevron"
                  aria-hidden="true"
                  width="10"
                  height="6"
                  viewBox="0 0 10 6"
                  fill="none"
                >
                  <path
                    d="M1 1l4 4 4-4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="b1-site-nav__mega-panel" role="region">
                {item.megaMenu.map((section) => (
                  <div class="b1-site-nav__mega-section">
                    <p class="b1-site-nav__mega-heading">{section.heading}</p>
                    {section.links.map((link) => (
                      <a
                        href={link.href}
                        class="b1-site-nav__mega-link"
                        data-site-nav-link
                      >
                        <span class="b1-site-nav__mega-link-label">
                          {link.label}
                        </span>
                        {link.description && (
                          <span class="b1-site-nav__mega-link-desc">
                            {link.description}
                          </span>
                        )}
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} data-site-nav-link>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="b1-site-nav__actions">
      <a href={signInHref} class="b1-site-nav__login" data-sign-in-link>
        {signInText}
      </a>
      <a href={ctaHref} class="b1-button b1-button--primary">
        {ctaText}
      </a>
      <details class="b1-site-nav__mobile">
        <summary aria-label="Toggle navigation menu">
          <span></span><span></span><span></span>
        </summary>
        <div class="b1-site-nav__mobile-panel">
          {
            simpleNav.map((item) =>
              item.megaMenu ? (
                <>
                  <span class="b1-site-nav__mobile-section-heading">
                    {item.label}
                  </span>
                  {item.megaMenu.flatMap((section) =>
                    section.links.map((link) => (
                      <a
                        href={link.href}
                        data-site-nav-link
                        class="b1-site-nav__mobile-mega-link"
                      >
                        {link.label}
                      </a>
                    )),
                  )}
                </>
              ) : (
                <a href={item.href} data-site-nav-link>
                  {item.label}
                </a>
              ),
            )
          }
          <a href={signInHref} data-sign-in-link>{signInText}</a>
          <a href={ctaHref} class="b1-site-nav__mobile-cta">{ctaText}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Mega-menu open/close behavior
  document
    .querySelectorAll<HTMLElement>("[data-mega-trigger]")
    .forEach((trigger) => {
      const btn = trigger.querySelector<HTMLButtonElement>("[aria-expanded]");
      const panel = trigger.querySelector<HTMLElement>(
        ".b1-site-nav__mega-panel",
      );
      if (!btn || !panel) return;

      btn.addEventListener("click", () => {
        const isOpen = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", isOpen ? "false" : "true");
        trigger.classList.toggle("is-open", !isOpen);
      });

      document.addEventListener("click", (e) => {
        if (!trigger.contains(e.target as Node)) {
          btn.setAttribute("aria-expanded", "false");
          trigger.classList.remove("is-open");
        }
      });
    });
</script>

<style>
  .b1-site-nav {
    z-index: 50;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--paper-0) 96%, white);
  }

  .b1-site-nav__inner {
    display: flex;
    min-height: 58px;
    width: min(100% - 28px, 1180px);
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-inline: auto;
    padding: 0;
  }

  .b1-site-nav__brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    color: var(--ink-0);
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
  }

  .b1-site-nav__wordmark {
    display: inline-flex;
    align-items: baseline;
    color: #12375c;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .b1-site-nav__wordmark span + span {
    color: #8c5a06;
  }

  .b1-site-nav__links {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 22px;
  }

  .b1-site-nav__links a,
  .b1-site-nav__login,
  .b1-site-nav__mobile-panel a {
    color: var(--ink-1);
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
  }

  .b1-site-nav__links a:hover,
  .b1-site-nav__login:hover,
  .b1-site-nav__mobile-panel a:hover {
    color: var(--accent);
  }

  .b1-site-nav__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* ---- Mega-menu trigger ---- */

  .b1-site-nav__mega-trigger {
    position: relative;
  }

  .b1-site-nav__mega-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 999px;
    padding: 0 10px;
    color: var(--ink-1);
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
  }

  .b1-site-nav__mega-btn:hover {
    color: var(--accent);
  }

  .b1-site-nav__chevron {
    transition: transform 0.15s ease;
  }

  .b1-site-nav__mega-trigger.is-open .b1-site-nav__chevron {
    transform: rotate(180deg);
  }

  /* ---- Mega-menu panel ---- */

  .b1-site-nav__mega-panel {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: min(760px, calc(100vw - 40px));
    gap: 0;
    flex-direction: row;
    flex-wrap: wrap;
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    background: var(--paper-0);
    padding: 20px;
    box-shadow: var(--shadow-3);
    z-index: 100;
  }

  .b1-site-nav__mega-trigger.is-open .b1-site-nav__mega-panel {
    display: flex;
  }

  .b1-site-nav__mega-section {
    flex: 1 1 180px;
    padding: 0 16px 0 0;
  }

  .b1-site-nav__mega-section:last-child {
    padding-right: 0;
  }

  .b1-site-nav__mega-heading {
    margin: 0 0 8px;
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .b1-site-nav__mega-link {
    display: flex;
    flex-direction: column;
    padding: 6px 8px;
    border-radius: var(--r-sm);
    color: var(--ink-1);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    gap: 2px;
    margin-bottom: 2px;
  }

  .b1-site-nav__mega-link:hover {
    background: var(--surface-1);
    color: var(--ink-0);
  }

  .b1-site-nav__mega-link-label {
    font-weight: 600;
    font-size: 13px;
  }

  .b1-site-nav__mega-link-desc {
    color: var(--ink-2);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
  }

  /* ---- Mobile ---- */

  .b1-site-nav__mobile {
    display: block;
    position: relative;
  }

  .b1-site-nav__mobile summary {
    display: grid;
    width: 44px;
    height: 44px;
    cursor: pointer;
    place-items: center;
    border: 1px solid var(--rule);
    border-radius: 999px;
    list-style: none;
  }

  .b1-site-nav__mobile summary::-webkit-details-marker {
    display: none;
  }

  .b1-site-nav__mobile summary span {
    display: block;
    width: 17px;
    height: 1.5px;
    background: var(--ink-0);
  }

  .b1-site-nav__mobile-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    width: min(260px, calc(100vw - 28px));
    max-height: calc(100dvh - var(--safe-top, 0px) - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    gap: 8px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    background: var(--paper-0);
    padding: 14px;
    box-shadow: var(--shadow-3);
  }

  .b1-site-nav__mobile-panel a {
    min-height: 44px;
    padding: 9px 10px;
  }

  .b1-site-nav__mobile-section-heading {
    display: block;
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px 0;
  }

  .b1-site-nav__mobile-mega-link {
    padding-left: 18px !important;
    font-size: 13px !important;
  }

  .b1-site-nav__mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--ink-0);
    color: var(--paper-0);
    font-weight: 700;
  }

  .b1-site-nav__mobile-panel .b1-site-nav__mobile-cta:hover {
    color: var(--paper-0);
  }

  .b1-site-nav__login,
  .b1-site-nav__actions > .b1-button {
    display: none;
  }

  @media (min-width: 64rem) {
    .b1-site-nav__inner {
      width: min(1180px, calc(100% - 40px));
    }

    .b1-site-nav__links {
      display: flex;
    }

    .b1-site-nav__login,
    .b1-site-nav__actions > .b1-button {
      display: inline-flex;
    }

    .b1-site-nav__mobile {
      display: none;
    }
  }
</style>
