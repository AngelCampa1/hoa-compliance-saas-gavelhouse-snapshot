---
interface Props {
  title: string;
  body: string;
  signals: string[];
}

const { title, body, signals } = Astro.props;
---

<div id="signup" class="home-final-cta__shell">
  <div class="home-final-cta__copy">
    <p class="home-final-cta__eyebrow editorial-kicker">
      Gavelhouse for the whole board
    </p>
    <h2 class="home-final-cta__title">{title}</h2>
    <p class="home-final-cta__body">{body}</p>
    <div class="home-final-cta__actions">
      <slot />
    </div>
  </div>

  <ul class="home-final-cta__signals" aria-label="What you get">
    {
      signals.map((signal) => (
        <li class="home-final-cta__signal">
          <span class="home-final-cta__signal-mark" aria-hidden="true" />
          <span>{signal}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .home-final-cta__shell {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: end;
  }

  .home-final-cta__copy {
    max-width: 42rem;
  }

  .home-final-cta__title {
    margin: 1rem 0 0;
    max-width: 14ch;
    font-family: var(--font-heading);
    font-size: clamp(2.45rem, 4.5vw, 4.8rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .home-final-cta__body {
    margin: 1.3rem 0 0;
    max-width: 35rem;
    font-size: 1.06rem;
    line-height: 1.78;
  }

  .home-final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.9rem;
  }

  .home-final-cta__signals {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    align-self: start;
  }

  .home-final-cta__signal {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
    line-height: 1.6;
    padding-top: 0.85rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-accent-400) 24%, transparent);
  }

  .home-final-cta__signal:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .home-final-cta__signal-mark {
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.65rem;
    border-radius: 999px;
    background: var(--color-accent-300);
  }

  @media (min-width: 68rem) {
    .home-final-cta__shell {
      grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.75fr);
    }
  }
</style>
