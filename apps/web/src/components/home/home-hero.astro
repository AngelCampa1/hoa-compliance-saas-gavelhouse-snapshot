---
import GeneratedProductMockup from "../generated-product-mockup.astro";
import { resolveProductVisualPreset } from "../../lib/generated-product-visuals";

interface OperatingLane {
  name: string;
  status: string;
  detail: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  highlights: string[];
  operatingLanes: OperatingLane[];
  stageNote: string;
}

const { eyebrow, title, lede, highlights } = Astro.props;
const productVisual = resolveProductVisualPreset({
  slug: "home-board-operating-record",
  productCategory: "Board records",
});
---

<section class="home-hero" id="features" data-hero>
  <div class="home-hero__aurora home-hero__aurora--left" aria-hidden="true">
  </div>
  <div class="home-hero__aurora home-hero__aurora--right" aria-hidden="true">
  </div>
  <div class="home-hero__grid">
    <div class="home-hero__copy">
      <p class="home-hero__eyebrow">{eyebrow}</p>
      <h1 class="home-hero__title">{title}</h1>
      <p class="home-hero__lede">{lede}</p>
      <div class="home-hero__actions">
        <slot />
      </div>
      <ul class="home-hero__highlights">
        {
          highlights.map((item) => (
            <li class="home-hero__highlight">
              <span class="home-hero__highlight-mark" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="home-hero__stage"
      aria-label="Gavelhouse operating model preview"
    >
      <GeneratedProductMockup {...productVisual} />
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: clip;
    padding: clamp(4.5rem, 7vw, 7rem) 1.25rem clamp(4rem, 6vw, 5.5rem);
    background:
      radial-gradient(
        circle at top left,
        color-mix(in srgb, var(--color-accent-100) 82%, transparent) 0%,
        transparent 42%
      ),
      radial-gradient(
        circle at 82% 18%,
        color-mix(in srgb, var(--color-primary-100) 88%, white) 0%,
        transparent 30%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, white 90%, var(--color-accent-50)),
        #fcfaf5 58%,
        #fffdfa 100%
      );
  }

  .home-hero__aurora {
    position: absolute;
    pointer-events: none;
    filter: blur(28px);
    opacity: 0.9;
  }

  .home-hero__aurora--left {
    left: -8rem;
    top: 3rem;
    height: 18rem;
    width: 18rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent-200) 76%, transparent);
    animation: heroFloat 12s cubic-bezier(0.22, 1, 0.36, 1) infinite alternate;
  }

  .home-hero__aurora--right {
    right: -6rem;
    bottom: 2rem;
    height: 15rem;
    width: 15rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary-200) 74%, transparent);
    animation: heroFloat 10s cubic-bezier(0.22, 1, 0.36, 1) infinite
      alternate-reverse;
  }

  .home-hero__grid {
    position: relative;
    z-index: 1;
    margin: 0 auto;
    display: grid;
    max-width: 78rem;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .home-hero__copy {
    max-width: 44rem;
  }

  .home-hero__eyebrow,
  .home-hero__highlight,
  .home-hero__frame-label,
  .home-hero__lane-name {
    font-family: var(--font-heading);
    font-style: italic;
  }

  .home-hero__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-primary-700) 82%, black);
    animation: heroReveal 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .home-hero__title {
    margin: 1.1rem 0 0;
    max-width: 10.5ch;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 7vw, 6.8rem);
    line-height: 0.93;
    letter-spacing: -0.06em;
    color: color-mix(in srgb, var(--color-brand-text) 94%, black);
    text-wrap: balance;
    animation: heroReveal 820ms cubic-bezier(0.16, 1, 0.3, 1) 80ms both;
  }

  .home-hero__lede {
    margin: 1.5rem 0 0;
    max-width: 38rem;
    font-size: clamp(1.08rem, 1.2rem + 0.4vw, 1.42rem);
    line-height: 1.75;
    color: color-mix(
      in srgb,
      var(--color-brand-muted) 86%,
      var(--color-primary-900)
    );
    animation: heroReveal 820ms cubic-bezier(0.16, 1, 0.3, 1) 170ms both;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.8rem;
    animation: heroReveal 820ms cubic-bezier(0.16, 1, 0.3, 1) 240ms both;
  }

  .home-hero__highlights {
    display: grid;
    gap: 0.95rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    animation: heroReveal 900ms cubic-bezier(0.16, 1, 0.3, 1) 320ms both;
  }

  .home-hero__highlight {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
    max-width: 40rem;
    font-size: 0.98rem;
    line-height: 1.7;
    color: color-mix(
      in srgb,
      var(--color-brand-text) 92%,
      var(--color-primary-900)
    );
  }

  .home-hero__highlight-mark {
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.45rem;
    border-radius: 999px;
    background:
      radial-gradient(
        circle at 32% 32%,
        color-mix(in srgb, white 70%, var(--color-accent-300)) 0 20%,
        transparent 21%
      ),
      color-mix(in srgb, var(--color-accent-500) 92%, var(--color-primary-900));
    box-shadow: 0 0 0 0.3rem
      color-mix(in srgb, var(--color-accent-100) 88%, transparent);
  }

  .home-hero__stage {
    position: relative;
    animation: heroStageIn 960ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
  }

  .home-hero__frame {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 2vw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--color-primary-900) 10%, white);
    border-radius: 2rem;
    background: var(--surface-primary);
    box-shadow:
      0 1.5rem 3rem rgba(31, 41, 55, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .home-hero__frame-top,
  .home-hero__lane-top {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.75rem;
  }

  .home-hero__frame-label {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(
      in srgb,
      var(--color-brand-muted) 80%,
      var(--color-primary-900)
    );
  }

  .home-hero__frame-title {
    margin: 0.45rem 0 0;
    max-width: 18ch;
    font-family: var(--font-heading);
    font-size: clamp(1.55rem, 2vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-brand-text);
  }

  .home-hero__frame-chip,
  .home-hero__lane-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--color-primary-800) 90%, black);
    background: color-mix(in srgb, var(--color-primary-100) 78%, white);
  }

  .home-hero__summary {
    display: grid;
    grid-template-columns: 1fr;
  }

  .home-hero__summary-card,
  .home-hero__lane {
    padding: 1rem 1rem 1.05rem;
    border-radius: 1.35rem;
    background: var(--surface-elevated);
    border: 1px solid color-mix(in srgb, var(--color-primary-900) 8%, white);
  }

  .home-hero__summary-label {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-accent-700) 82%, black);
  }

  .home-hero__summary-text,
  .home-hero__lane-detail,
  .home-hero__note {
    margin: 0.55rem 0 0;
    line-height: 1.65;
    color: color-mix(
      in srgb,
      var(--color-brand-text) 88%,
      var(--color-primary-900)
    );
  }

  .home-hero__lanes {
    display: grid;
    gap: 0.85rem;
  }

  .home-hero__lane {
    position: relative;
    overflow: hidden;
  }

  .home-hero__lane:nth-child(2) {
    transform: translateX(-0.35rem);
  }

  .home-hero__lane:nth-child(3) {
    transform: translateX(0.4rem);
  }

  .home-hero__lane::after {
    content: "";
    position: absolute;
    inset: auto auto 0.65rem 1rem;
    width: 4rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-accent-500) 36%, transparent);
  }

  .home-hero__lane-name {
    margin: 0;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-primary-700) 85%, black);
  }

  .home-hero__lane-status {
    font-size: 0.72rem;
    padding-inline: 0.65rem;
  }

  .home-hero__note {
    margin-top: 0.2rem;
    padding-top: 1rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-primary-900) 10%, white);
    font-size: 0.94rem;
  }

  @media (min-width: 48rem) {
    .home-hero__frame-top,
    .home-hero__lane-top {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .home-hero__summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .home-hero__grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(24rem, 0.88fr);
    }

    .home-hero__stage {
      padding-top: 2.2rem;
    }
  }

  @media (min-width: 64rem) {
    .home-hero__stage::before {
      content: "";
      position: absolute;
      inset: 7% -3% -5% 8%;
      z-index: 0;
      border-radius: 2.6rem;
      background:
        linear-gradient(
          135deg,
          color-mix(in srgb, var(--color-primary-200) 62%, transparent),
          transparent 48%
        ),
        linear-gradient(
          155deg,
          color-mix(in srgb, var(--color-accent-200) 52%, transparent),
          transparent 72%
        );
      opacity: 0.9;
      transform: rotate(-5deg);
    }
  }

  @keyframes heroReveal {
    from {
      opacity: 0;
      transform: translateY(22px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroStageIn {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.98) rotate(-1deg);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1) rotate(0deg);
    }
  }

  @keyframes heroFloat {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(1.25rem, -0.8rem, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__aurora--left,
    .home-hero__aurora--right,
    .home-hero__eyebrow,
    .home-hero__title,
    .home-hero__lede,
    .home-hero__actions,
    .home-hero__highlights,
    .home-hero__stage {
      animation: none;
    }

    .home-hero__lane:nth-child(2),
    .home-hero__lane:nth-child(3) {
      transform: none;
    }
  }
</style>
