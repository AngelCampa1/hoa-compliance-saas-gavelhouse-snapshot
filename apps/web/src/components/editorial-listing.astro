---
import type { ContentItem } from "../lib/types";
import ContentCard from "./content-card.astro";
import SectionBand from "./section-band.astro";
import { STAGE_BADGES, formatContentDate } from "../lib/content-helpers";

interface Props {
  items: ContentItem[];
  leadCount?: number;
  interludeEyebrow?: string;
  interludeTitle?: string;
  interludeBody?: string;
  /**
   * Insert the ink editorial interlude after this many items in the rest grid.
   * Only triggered when rest.length > repeatEvery.
   */
  repeatEvery?: number;
}

const {
  items,
  leadCount = 1,
  interludeEyebrow = "Why this section",
  interludeTitle,
  interludeBody,
  repeatEvery = 8,
} = Astro.props;

const leadItems = items.slice(0, leadCount);
const restItems = items.slice(leadCount);

// Split rest into a left column (~2/3, gets secondary cards) and a right column
// (~1/3, gets tight serif list). Roughly 60/40 split in count.
function splitAsymmetric<T>(list: T[]): { left: T[]; right: T[] } {
  if (list.length === 0) return { left: [], right: [] };
  const leftCount = Math.ceil(list.length * 0.6);
  return {
    left: list.slice(0, leftCount),
    right: list.slice(leftCount),
  };
}

// For long lists, slice rest into chunks of `repeatEvery` and interleave with
// an ink interlude. For short lists, it's one slice.
const restChunks: ContentItem[][] = [];
if (restItems.length <= repeatEvery) {
  if (restItems.length > 0) restChunks.push(restItems);
} else {
  for (let i = 0; i < restItems.length; i += repeatEvery) {
    restChunks.push(restItems.slice(i, i + repeatEvery));
  }
}

const showInterlude = Boolean(interludeBody);
---

<div class="editorial-listing">
  {
    leadItems.length > 0 && (
      <div class="editorial-listing__lead-stack">
        {leadItems.map((item) => {
          const badge = STAGE_BADGES[item.buyerStage];
          const updated = formatContentDate(item.updatedAt);
          const readTime = item.metadata?.readTime;
          const competitor = item.metadata?.competitor;
          const kicker = competitor
            ? `A ${competitor} ${badge.label.toLowerCase()}, updated ${updated}`
            : `A ${badge.label.toLowerCase()}, updated ${updated}`;
          const related = (item.relatedPages ?? []).slice(0, 3);
          return (
            <article class="editorial-listing__lead">
              <p class="u-kicker-serif" style="margin: 0;">
                {kicker}
              </p>
              <h2 class="editorial-listing__lead-title">
                <a href={item.href} class="editorial-listing__lead-link">
                  {item.title}
                </a>
              </h2>
              <p class="u-lede editorial-listing__lead-lede">
                {item.description}
              </p>
              <div class="editorial-listing__lead-meta">
                <span>{readTime ? `${readTime} read` : "Full breakdown"}</span>
                <a href={item.href} class="editorial-listing__lead-cta">
                  Read the breakdown &rarr;
                </a>
              </div>
              {related.length > 0 && (
                <p class="u-inline-metadata editorial-listing__lead-related">
                  Also in this issue:{" "}
                  {related.map((link, idx) => (
                    <>
                      <a
                        href={link.href}
                        class="editorial-listing__related-link"
                      >
                        {link.title}
                      </a>
                      {idx < related.length - 1 && <span>{" / "}</span>}
                    </>
                  ))}
                </p>
              )}
            </article>
          );
        })}
      </div>
    )
  }

  {
    restChunks.map((chunk, chunkIdx) => {
      const { left, right } = splitAsymmetric(chunk);
      return (
        <>
          {chunkIdx > 0 && showInterlude && (
            <SectionBand surface="ink" class="editorial-listing__interlude">
              <p class="u-kicker-serif" style="margin: 0;">
                {interludeEyebrow}
              </p>
              {interludeTitle && (
                <h3 class="editorial-listing__interlude-title">
                  {interludeTitle}
                </h3>
              )}
              <p class="editorial-listing__interlude-body">{interludeBody}</p>
            </SectionBand>
          )}
          {chunkIdx === 0 && showInterlude && leadItems.length > 0 && (
            <SectionBand surface="ink" class="editorial-listing__interlude">
              <p class="u-kicker-serif" style="margin: 0;">
                {interludeEyebrow}
              </p>
              {interludeTitle && (
                <h3 class="editorial-listing__interlude-title">
                  {interludeTitle}
                </h3>
              )}
              <p class="editorial-listing__interlude-body">{interludeBody}</p>
            </SectionBand>
          )}
          <div class="editorial-listing__grid">
            <div class="editorial-listing__col-main">
              {left.map((item) => (
                <ContentCard item={item} variant="secondary" />
              ))}
            </div>
            {right.length > 0 && (
              <aside
                class="editorial-listing__col-side"
                aria-label="More in this section"
              >
                <p class="u-kicker-serif editorial-listing__col-side-kicker">
                  Also in this section
                </p>
                <ul class="editorial-listing__tight-list">
                  {right.map((item) => (
                    <li>
                      <ContentCard item={item} variant="tight" />
                    </li>
                  ))}
                </ul>
              </aside>
            )}
          </div>
        </>
      );
    })
  }
</div>

<style>
  .editorial-listing {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 4vw, 4rem);
  }

  .editorial-listing__lead-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 3vw, 3rem);
  }

  .editorial-listing__lead {
    position: relative;
    max-width: var(--content-measure-wide, 72ch);
    padding-bottom: clamp(1.5rem, 2.5vw, 2.25rem);
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-brand-primary) 22%, transparent);
  }

  .editorial-listing__lead-title {
    margin: 0.4rem 0 0;
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--color-brand-text);
    font-size: clamp(2rem, 3.4vw, 3rem);
  }

  .editorial-listing__lead-link {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-brand-primary) 50%, transparent),
      color-mix(in srgb, var(--color-brand-primary) 50%, transparent)
    );
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 220ms ease;
  }

  .editorial-listing__lead-link:hover {
    background-size: 100% 1px;
  }

  .editorial-listing__lead-lede {
    margin-top: 1rem;
    max-width: 58ch;
  }

  .editorial-listing__lead-meta {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.25rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--color-brand-muted);
  }

  .editorial-listing__lead-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-style: normal;
    font-weight: 600;
    color: var(--color-accent-600);
    text-decoration: none;
  }

  .editorial-listing__lead-cta:hover {
    color: var(--color-accent-700);
  }

  .editorial-listing__lead-related {
    margin-top: 1rem;
    max-width: 64ch;
    line-height: 1.55;
  }

  .editorial-listing__related-link {
    color: var(--color-brand-text);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-brand-primary) 35%,
      transparent
    );
    text-underline-offset: 3px;
  }

  .editorial-listing__related-link:hover {
    color: var(--color-brand-primary);
  }

  .editorial-listing__interlude {
    margin-block: 0;
  }

  .editorial-listing__interlude :global(.section-band__inner) {
    padding-block: clamp(2rem, 3vw, 2.75rem);
  }

  .editorial-listing__interlude-title {
    margin: 0.4rem 0 0.75rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.25rem, 1.6vw, 1.6rem);
    line-height: 1.25;
    color: inherit;
  }

  .editorial-listing__interlude-body {
    max-width: 62ch;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    line-height: 1.6;
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    color: inherit;
    opacity: 0.88;
  }

  .editorial-listing__grid {
    display: grid;
    gap: clamp(2rem, 3vw, 3rem);
  }

  @media (min-width: 48rem) {
    .editorial-listing__grid {
      grid-template-columns: minmax(0, 1.9fr) minmax(15rem, 1fr);
      align-items: start;
    }
  }

  .editorial-listing__col-main {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 2.4vw, 2.5rem);
  }

  .editorial-listing__col-main > :global(a + a),
  .editorial-listing__col-main
    > :global(.content-card-secondary + .content-card-secondary) {
    padding-top: clamp(1.75rem, 2.4vw, 2.5rem);
    border-top: 1px solid
      color-mix(in srgb, var(--color-neutral-300) 55%, transparent);
  }

  .editorial-listing__col-side {
    position: relative;
    padding-left: 0;
    padding-top: 1.5rem;
    margin-top: 0.5rem;
    border-left: 0;
    border-top: 1px solid
      color-mix(in srgb, var(--color-brand-primary) 18%, transparent);
  }

  @media (min-width: 48rem) {
    .editorial-listing__col-side {
      padding-left: clamp(0rem, 1.5vw, 1.25rem);
      padding-top: 0;
      margin-top: 0;
      border-left: 1px solid
        color-mix(in srgb, var(--color-brand-primary) 18%, transparent);
      border-top: 0;
    }
  }

  .editorial-listing__col-side-kicker {
    margin: 0 0 1.25rem;
  }

  .editorial-listing__tight-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .editorial-listing__tight-list > li {
    padding-bottom: 1.1rem;
    border-bottom: 1px dotted
      color-mix(in srgb, var(--color-neutral-300) 65%, transparent);
  }

  .editorial-listing__tight-list > li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
</style>
