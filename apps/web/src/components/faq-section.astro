---
import SchemaMarkup from "../seo/schema-markup.astro";
import { buildFaqPageSchema } from "../lib/schema-builders";
import { PlusIcon, MinusIcon } from "../lib/icons";
import { resolveFaqHeading } from "../lib/faq-utils";
import type { FaqItem } from "../lib/types";

interface Props {
  faqs: FaqItem[];
  heading?: string;
  bottomCtaHeading?: string;
  bottomCtaText?: string;
  bottomCtaTarget?: string;
  defaultOpenCount?: number;
  emitSchema?: boolean;
  showBottomCta?: boolean;
  ctaVariant?: "solid" | "compact";
}

const {
  faqs,
  heading,
  bottomCtaHeading,
  bottomCtaText,
  bottomCtaTarget,
  defaultOpenCount = 0,
  emitSchema = false,
  showBottomCta,
  ctaVariant = "solid",
} = Astro.props;

const shouldShowBottomCta =
  showBottomCta ??
  Boolean(bottomCtaHeading && bottomCtaText && bottomCtaTarget);
const faqSchema =
  emitSchema && faqs.length > 0 ? buildFaqPageSchema(faqs) : null;
---

{
  faqs.length > 0 && (
    <section
      data-section="faq"
      data-faq-section
      class="faq-section px-4 py-[var(--section-py)]"
    >
      <div class="faq-shell mx-auto max-w-4xl">
        <div class="max-w-[var(--content-measure)]">
          <p class="editorial-kicker">Frequently asked</p>
          <h2 class="mt-4 text-balance font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
            {resolveFaqHeading(heading)}
          </h2>
        </div>

        <div class="faq-list mt-[var(--component-gap)]">
          {faqs.map((faq, index) => (
            <details
              open={index < defaultOpenCount || undefined}
              class="faq-item group border-b border-[color-mix(in_srgb,var(--color-neutral-200)_84%,transparent)] last:border-b-0"
            >
              <summary class="faq-trigger flex list-none cursor-pointer items-start justify-between gap-4 px-5 py-4 font-medium text-brand-text transition-colors duration-[var(--transition-fast)] hover:bg-[color-mix(in_srgb,var(--surface-elevated)_46%,white)] focus-visible:rounded-[var(--radius-md)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary-500)] focus-visible:ring-offset-2 sm:px-6 sm:py-5">
                <span class="max-w-[42rem] leading-6">{faq.q}</span>
                <span
                  class="mt-0.5 ml-4 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--color-accent-300)_70%,transparent)] bg-[color-mix(in_srgb,var(--surface-primary)_72%,white)] select-none text-[var(--color-accent-600)]"
                  aria-hidden="true"
                >
                  <span class="group-open:hidden" set:html={PlusIcon} />
                  <span class="hidden group-open:block" set:html={MinusIcon} />
                </span>
              </summary>
              <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-200 ease-out group-open:grid-rows-[1fr]">
                <div class="overflow-hidden">
                  <div class="faq-answer border-t border-[color-mix(in_srgb,var(--color-neutral-300)_42%,transparent)] px-5 pb-5 pt-4 text-base leading-7 text-brand-muted sm:px-6">
                    {faq.a}
                  </div>
                </div>
              </div>
            </details>
          ))}
        </div>

        {shouldShowBottomCta &&
          bottomCtaHeading &&
          bottomCtaText &&
          bottomCtaTarget &&
          (ctaVariant === "compact" ? (
            <div class="mt-8 border-t border-[color-mix(in_srgb,var(--color-brand-primary)_14%,transparent)] pt-5 md:flex md:items-center md:justify-between md:gap-6">
              <div class="max-w-[34rem]">
                <h3 class="font-heading text-[length:var(--text-subheading)] font-bold text-[var(--color-brand-text)]">
                  {bottomCtaHeading}
                </h3>
              </div>
              <a
                href={bottomCtaTarget}
                class="btn-primary mt-4 no-underline md:mt-0"
              >
                {bottomCtaText}
              </a>
            </div>
          ) : (
            <div class="mt-12 border-t border-[color-mix(in_srgb,var(--color-accent-200)_85%,transparent)] px-4 pt-8 text-center">
              <h3 class="mb-4 font-heading text-[length:var(--text-subheading)] font-bold text-[var(--color-accent-950)]">
                {bottomCtaHeading}
              </h3>
              <a
                href={bottomCtaTarget}
                class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--color-accent-950)] px-8 py-3 font-heading text-[length:var(--text-body-lg)] font-bold text-[var(--color-accent-50)] no-underline transition-[background-color,transform] hover:-translate-y-px hover:bg-[var(--color-accent-900)] active:scale-[0.97]"
              >
                {bottomCtaText}
              </a>
            </div>
          ))}

        <SchemaMarkup schemas={faqSchema ? [faqSchema] : []} />
      </div>
    </section>
  )
}
