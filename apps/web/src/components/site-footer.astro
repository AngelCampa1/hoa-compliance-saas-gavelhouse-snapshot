---
import { getCurrentYear } from "../lib/dates";
import BrandLogoMark from "./brand-logo-mark.astro";
import { BRAND_DOMAIN } from "@boardstack/shared";

interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  siteName: string;
  tagline?: string;
  linkGroups?: { heading: string; links: FooterLink[] }[];
  legalLinks?: FooterLink[];
  emailCapture?: unknown;
  footerTextColor?: string;
  copyrightSuffix?: string;
  contactEmail?: string;
  captureVariant?: "full" | "compact" | "none";
  surface?: "parchment" | "ink";
  colophon?: string;
}

const {
  siteName,
  tagline = "Compliance-first HOA & condo software for self-managed boards.",
  linkGroups = [
    {
      heading: "Product",
      links: [
        { label: "Features", href: "/features/" },
        { label: "Pricing", href: "/pricing/" },
        { label: "HOA compliance", href: "/hoa-compliance/" },
      ],
    },
    {
      heading: "Resources",
      links: [
        { label: "Guides", href: "/resources/" },
        { label: "Free templates", href: "/free/" },
        { label: "Compare", href: "/compare/" },
      ],
    },
    {
      heading: "Company",
      links: [
        { label: "About", href: "/about/" },
        { label: "Contact", href: "/contact/" },
      ],
    },
    {
      heading: "Legal",
      links: [
        { label: "Privacy", href: "/privacy/" },
        { label: "Terms", href: "/terms/" },
        { label: "DPA", href: "/dpa/" },
        { label: "Subprocessors", href: "/subprocessors/" },
      ],
    },
  ],
  legalLinks = [],
  contactEmail,
} = Astro.props;

const groups =
  linkGroups.length >= 4
    ? linkGroups.slice(0, 4)
    : [
        ...linkGroups,
        {
          heading: "Legal",
          links:
            legalLinks.length > 0
              ? legalLinks
              : [
                  { label: "Privacy", href: "/privacy/" },
                  { label: "Terms", href: "/terms/" },
                  { label: "DPA", href: "/dpa/" },
                  { label: "Subprocessors", href: "/subprocessors/" },
                ],
        },
      ];
const currentYear = getCurrentYear();
---

<footer class="b1-site-footer">
  <div class="b1-site-footer__grid">
    <div class="b1-site-footer__brand">
      <a href="/" class="b1-site-footer__logo" aria-label={`${siteName} home`}>
        <BrandLogoMark size="sm" />
        <span class="b1-site-footer__wordmark">
          <span>Gavel</span><span>house</span>
        </span>
      </a>
      <p>{tagline}</p>
      {contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
    </div>

    {
      groups.map((group) => (
        <details class="b1-site-footer__group">
          <summary class="b1-site-footer__summary">
            <h2>{group.heading}</h2>
            <span class="b1-site-footer__chevron" aria-hidden="true">
              ▾
            </span>
          </summary>
          <nav aria-label={group.heading} class="b1-site-footer__nav">
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      ))
    }

    <div class="b1-site-footer__bottom">
      <span>© {currentYear} {siteName}</span>
      <span>{BRAND_DOMAIN}</span>
    </div>
  </div>
</footer>

<style>
  .b1-site-footer {
    background: var(--ink-0);
    color: #c9c2b1;
    padding: 40px 28px 24px;
    padding-bottom: calc(24px + var(--safe-bottom));
  }

  .b1-site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    width: min(1180px, 100%);
    margin-inline: auto;
  }

  .b1-site-footer__logo {
    display: inline-flex;
    min-height: 44px;
    min-width: 44px;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-family: var(--sans);
    font-weight: 700;
    text-decoration: none;
  }

  .b1-site-footer__wordmark {
    display: inline-flex;
    align-items: baseline;
    color: #f7efe1;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .b1-site-footer__wordmark span + span {
    color: #e0a11f;
  }

  .b1-site-footer__brand p {
    max-width: 28ch;
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1.6;
    margin-top: 12px;
  }

  .b1-site-footer__brand a:not(.b1-site-footer__logo) {
    display: inline-flex;
    min-height: 44px;
    min-width: 44px;
    align-items: center;
    color: var(--accent-2);
    font-size: 13px;
    text-decoration: none;
  }

  /* accordion group */
  .b1-site-footer__group {
    border-bottom: 1px solid #1e1a12;
  }

  .b1-site-footer__summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    padding: 0;
  }

  .b1-site-footer__summary::-webkit-details-marker {
    display: none;
  }

  .b1-site-footer__summary h2 {
    margin: 0;
    color: #f3eddd;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .b1-site-footer__chevron {
    color: #524a3a;
    font-size: 16px;
    transition: transform 0.2s ease;
  }

  details[open] .b1-site-footer__chevron {
    transform: rotate(180deg);
  }

  .b1-site-footer__nav {
    padding-bottom: 12px;
  }

  .b1-site-footer ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .b1-site-footer li {
    margin: 0;
  }

  .b1-site-footer nav a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    color: #c9c2b1;
    font-size: 13px;
    text-decoration: none;
  }

  .b1-site-footer nav a:hover {
    color: #fff;
  }

  .b1-site-footer__bottom {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid #1e1a12;
    padding-top: 18px;
    margin-top: 18px;
    color: #a89c84;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* desktop: multi-column grid, no accordion behaviour */
  @media (min-width: 55rem) {
    .b1-site-footer__grid {
      grid-template-columns: 1.4fr repeat(4, 1fr);
      gap: 24px;
    }

    .b1-site-footer__group {
      border-bottom: none;
    }

    .b1-site-footer__summary {
      pointer-events: none;
      cursor: default;
    }

    .b1-site-footer__chevron {
      display: none;
    }

    details.b1-site-footer__group[open],
    details.b1-site-footer__group:not([open]) {
      /* Force nav visible on desktop regardless of open/closed state */
    }

    .b1-site-footer__nav {
      display: block !important;
      padding-bottom: 0;
    }

    .b1-site-footer ul {
      gap: 10px;
    }

    .b1-site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      gap: 18px;
      margin-top: 0;
    }

    .b1-site-footer__brand p {
      margin-top: 8px;
    }
  }
</style>

<script is:inline>
  (() => {
    // On desktop, force all details elements open and prevent toggle.
    // On mobile, start all closed.
    const mq = window.matchMedia("(min-width: 55rem)");
    const allDetails = document.querySelectorAll(".b1-site-footer__group");

    function applyDesktopState(isDesktop) {
      allDetails.forEach((el) => {
        if (isDesktop) {
          el.setAttribute("open", "");
        } else {
          el.removeAttribute("open");
        }
      });
    }

    applyDesktopState(mq.matches);
    mq.addEventListener("change", (e) => applyDesktopState(e.matches));

    // Prevent summary click from toggling on desktop.
    allDetails.forEach((el) => {
      const summary = el.querySelector("summary");
      if (summary) {
        summary.addEventListener("click", (e) => {
          if (mq.matches) {
            e.preventDefault();
          }
        });
      }
    });
  })();
</script>
