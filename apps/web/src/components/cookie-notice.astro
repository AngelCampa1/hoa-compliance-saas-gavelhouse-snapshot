<aside
  id="cookie-notice"
  class="cookie-notice hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-neutral-300)_55%,transparent)] bg-[color-mix(in_srgb,var(--surface-elevated)_96%,white)] p-4 shadow-[var(--shadow-card)]"
  aria-live="polite"
>
  <p class="pr-10 text-sm leading-6 text-[var(--color-brand-text)]">
    Gavelhouse uses PostHog for product analytics on this site. By continuing to
    browse, you agree to that limited analytics use as described in our
    <a href="/privacy/" class="underline underline-offset-2">Privacy Policy</a>.
  </p>
  <button
    id="cookie-notice-dismiss"
    type="button"
    class="mt-3 inline-flex min-h-11 items-center justify-center rounded-full bg-[var(--color-primary-600)] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[var(--color-primary-700)]"
  >
    Dismiss
  </button>
</aside>

<style>
  .cookie-notice {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    bottom: calc(1rem + var(--safe-bottom));
    max-width: none;
    z-index: 60;
  }

  @media (min-width: 40rem) {
    .cookie-notice {
      left: auto;
      right: 1.25rem;
      bottom: max(1.25rem, var(--safe-bottom));
      max-width: 360px;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("cookie-notice");
    const dismiss = document.getElementById("cookie-notice-dismiss");
    if (!root || !dismiss) return;

    try {
      if (window.localStorage.getItem("gavelhouse-cookie-notice-dismissed")) {
        return;
      }
    } catch {
      // Ignore storage failures and continue showing the notice.
    }

    root.classList.remove("hidden");

    dismiss.addEventListener("click", () => {
      root.classList.add("hidden");
      try {
        window.localStorage.setItem(
          "gavelhouse-cookie-notice-dismissed",
          "true",
        );
      } catch {
        // Ignore storage failures after dismissal.
      }
    });
  })();
</script>
