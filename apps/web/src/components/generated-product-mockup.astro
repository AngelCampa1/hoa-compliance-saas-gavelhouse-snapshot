---
import type {
  GeneratedProductVisualPreset,
  GeneratedProductVisualTone,
} from "../lib/generated-product-visuals";

interface Props extends Omit<GeneratedProductVisualPreset, "tone"> {
  tone?: GeneratedProductVisualTone;
  compact?: boolean;
}

const {
  variant,
  title,
  caption,
  primaryMetric,
  rows,
  actions,
  tone = "paper",
  compact = false,
} = Astro.props as Props;
---

<aside
  class:list={[
    "generated-product-mockup",
    `generated-product-mockup--${variant}`,
    `generated-product-mockup--${tone}`,
    compact && "generated-product-mockup--compact",
  ]}
  aria-label={`${title} product preview`}
>
  <div class="generated-product-mockup__chrome" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div class="generated-product-mockup__header">
    <div>
      <p class="generated-product-mockup__label">Gavelhouse</p>
      <h2>{title}</h2>
    </div>
    <strong>{primaryMetric}</strong>
  </div>
  <p class="generated-product-mockup__caption">{caption}</p>
  <div class="generated-product-mockup__grid">
    {
      rows.map((row) => (
        <article class="generated-product-mockup__row">
          <div>
            <span>{row.label}</span>
            <b>{row.value}</b>
          </div>
          {row.status && <em>{row.status}</em>}
        </article>
      ))
    }
  </div>
  <div class="generated-product-mockup__actions" aria-label="Preview actions">
    {actions.map((action) => <span>{action}</span>)}
  </div>
</aside>

<style>
  .generated-product-mockup {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1rem;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--color-brand-primary) 18%, transparent);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 2vw, 1.35rem);
    color: var(--color-brand-text);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--surface-primary) 94%, white),
      color-mix(in srgb, var(--surface-secondary) 82%, white)
    );
    box-shadow: var(--shadow-lg);
  }

  .generated-product-mockup::before {
    content: "";
    position: absolute;
    inset: -22% -16% auto auto;
    z-index: -1;
    width: 14rem;
    height: 14rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent-200) 42%, transparent);
  }

  .generated-product-mockup--ink {
    color: white;
    border-color: color-mix(in srgb, white 16%, transparent);
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--color-brand-text) 92%, black),
      color-mix(in srgb, var(--color-brand-primary) 72%, black)
    );
  }

  .generated-product-mockup--accent {
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-accent-50) 88%, white),
      color-mix(in srgb, var(--surface-primary) 90%, white)
    );
  }

  .generated-product-mockup--compact {
    gap: 0.75rem;
  }

  .generated-product-mockup__chrome {
    display: flex;
    gap: 0.35rem;
  }

  .generated-product-mockup__chrome span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 28%, transparent);
  }

  .generated-product-mockup__header {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    align-items: start;
  }

  .generated-product-mockup__label {
    margin: 0 0 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-style: italic;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 62%, transparent);
  }

  .generated-product-mockup h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    line-height: 1.08;
    color: currentColor;
  }

  .generated-product-mockup__header strong {
    display: inline-flex;
    max-width: none;
    min-height: 2.3rem;
    align-items: center;
    justify-content: start;
    border-radius: var(--radius-md);
    padding: 0.45rem 0.7rem;
    text-align: center;
    font-size: 0.82rem;
    line-height: 1.25;
    color: var(--color-brand-text);
    background: color-mix(in srgb, var(--color-accent-100) 78%, white);
  }

  .generated-product-mockup--ink .generated-product-mockup__header strong {
    color: white;
    background: color-mix(in srgb, white 14%, transparent);
  }

  .generated-product-mockup__caption {
    margin: 0;
    max-width: 56ch;
    font-size: 0.94rem;
    line-height: 1.6;
    color: color-mix(in srgb, currentColor 74%, transparent);
  }

  .generated-product-mockup__grid {
    display: grid;
    gap: 0.65rem;
  }

  .generated-product-mockup__row {
    display: grid;
    gap: 0.8rem;
    grid-template-columns: 1fr;
    align-items: center;
    min-width: 0;
    border: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    border-radius: var(--radius-md);
    padding: 0.85rem;
    background: color-mix(in srgb, var(--surface-primary) 72%, transparent);
  }

  .generated-product-mockup--ink .generated-product-mockup__row {
    background: color-mix(in srgb, white 8%, transparent);
  }

  .generated-product-mockup__row span,
  .generated-product-mockup__row em {
    display: block;
    font-size: 0.72rem;
    line-height: 1.35;
    color: color-mix(in srgb, currentColor 62%, transparent);
  }

  .generated-product-mockup__row b {
    display: block;
    margin-top: 0.18rem;
    font-size: 0.95rem;
    line-height: 1.35;
    color: currentColor;
  }

  .generated-product-mockup__row em {
    max-width: 6.5rem;
    border-radius: 999px;
    padding: 0.28rem 0.5rem;
    text-align: center;
    font-style: normal;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .generated-product-mockup__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .generated-product-mockup__actions span {
    border-radius: 999px;
    padding: 0.4rem 0.65rem;
    font-size: 0.76rem;
    font-weight: 700;
    color: currentColor;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .generated-product-mockup__header,
  .generated-product-mockup__row {
    grid-template-columns: 1fr;
  }

  .generated-product-mockup__header strong,
  .generated-product-mockup__row em {
    justify-content: start;
    max-width: none;
    width: max-content;
  }

  @media (min-width: 36rem) {
    .generated-product-mockup__header,
    .generated-product-mockup__row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .generated-product-mockup__header strong,
    .generated-product-mockup__row em {
      justify-content: center;
      max-width: 10rem;
      width: auto;
    }
  }
</style>
