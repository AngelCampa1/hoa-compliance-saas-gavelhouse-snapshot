---
import { buildCtaAnalyticsAttributes } from "../lib/cta-analytics";
import type { CtaAnalyticsContext } from "../lib/types";

interface Props {
  ctaText: string;
  ctaTarget: string;
  subtitle?: string;
  bullets?: string[];
  trustNote?: string;
  analytics?: CtaAnalyticsContext;
}

const { ctaText, ctaTarget, subtitle, bullets, trustNote, analytics } =
  Astro.props;
const analyticsAttributes = buildCtaAnalyticsAttributes({
  ...analytics,
  target: ctaTarget,
});
---

<div class="lg:sticky lg:top-24" data-section="sidebar-cta">
  <div
    data-sidebar-cta-panel
    class="relative overflow-hidden rounded-[calc(var(--radius-lg)+2px)] border border-[color-mix(in_srgb,var(--color-neutral-300)_34%,transparent)] bg-[linear-gradient(155deg,color-mix(in_srgb,var(--surface-primary)_92%,white),color-mix(in_srgb,var(--surface-secondary)_72%,var(--surface-primary)))] p-5 shadow-[var(--shadow-card)]"
  >
    <p class="u-kicker-serif">Gavelhouse</p>
    {
      subtitle && (
        <p class="mb-4 mt-3 text-[length:var(--text-body)] leading-7 text-[var(--color-neutral-600)]">
          {subtitle}
        </p>
      )
    }
    {
      bullets && bullets.length > 0 && (
        <ul class="mb-5 space-y-3">
          {bullets.map((bullet) => (
            <li class="flex items-start gap-2 rounded-[var(--radius-sm)] border border-[color-mix(in_srgb,var(--color-brand-primary)_12%,transparent)] bg-[color-mix(in_srgb,var(--surface-elevated)_68%,white)] px-3 py-2 text-[length:var(--text-caption)] text-[var(--color-neutral-700)]">
              <svg
                class="w-4 h-4 mt-0.5 shrink-0 text-[var(--color-brand-primary)]"
                aria-hidden="true"
                viewBox="0 0 16 16"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      )
    }
    <a
      href={ctaTarget}
      class="btn-primary mt-2 block w-full text-center no-underline"
      {...analyticsAttributes}>{ctaText}</a
    >
    {trustNote && <p class="u-inline-metadata mt-4 text-center">{trustNote}</p>}
  </div>
</div>
