---
import "../../styles/global.css";
import { getCollection } from "astro:content";
import CategoryHub from "../../hubs/category-hub.astro";
import PublicSignupCta from "../../components/public-signup-cta.astro";
import ComplianceHero from "../../components/heroes/compliance-hero.astro";
import SectionBand from "../../components/section-band.astro";
import StateReserveLawMap from "../../components/data-viz/state-reserve-law-map.astro";
import { siteConfig } from "../../config/site";
import { hubFaqs } from "../../config/hub-faqs";
import { sortByUpdatedAtDesc, mapToContentItems } from "../../lib/collections";
import { STATE_RESERVE_REQUIREMENTS } from "@boardstack/shared";
import type { GetStaticPathsOptions } from "astro";

const rules = Object.values(STATE_RESERVE_REQUIREMENTS);
const mandateCount = rules.filter((r) => r.reserveStudyRequired).length;
const commingleCount = rules.filter((r) => r.commingleProhibited).length;

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const entries = await getCollection("state-pages");
  const sorted = sortByUpdatedAtDesc(entries);
  const items = mapToContentItems(
    sorted,
    (e) => `/hoa-compliance/${e.slug}/`,
    (e) => ({ state: e.data.state }),
  );
  return paginate(items, { pageSize: 12 });
}

const { page } = Astro.props;
---

<CategoryHub
  config={siteConfig}
  title="HOA rules by state"
  description={`${mandateCount} states require reserve studies on set schedules. ${commingleCount} states ban mixing reserve and operating funds. Penalties can run from $100/day to $10,000 per violation.`}
  items={page.data}
  page={page}
  basePath="/hoa-compliance"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "HOA Compliance", href: "/hoa-compliance/" },
  ]}
  faqs={hubFaqs["/hoa-compliance"]}
  eyebrow="Compliance library"
  variant="editorial"
>
  <ComplianceHero slot="custom-hero" />
  {
    page.currentPage === 1 && (
      <SectionBand slot="intro" surface="paper">
        <div class="compliance-map-band">
          <p class="u-kicker-serif">42 states. 4 reserve-law groups.</p>
          <p class="compliance-map-band__lede">Where does yours fall?</p>
          <StateReserveLawMap variant="parchment" showLegend={true} />
        </div>
      </SectionBand>
    )
  }
  <SectionBand slot="cta" surface="ink">
    <section class="py-2 text-center" id="signup">
      <h2 class="text-2xl font-bold mb-2">Know your state rules.</h2>
      <p class="mb-6 max-w-2xl mx-auto">
        Try Scale features first. Pick a plan later. Keep the 30-day money-back
        guarantee.
      </p>
      <PublicSignupCta sourcePage="/hoa-compliance" buttonText="Start trial" />
    </section>
  </SectionBand>
</CategoryHub>

<style>
  .compliance-map-band {
    display: grid;
    gap: 0.85rem;
  }

  .compliance-map-band__lede {
    margin: 0 0 1.25rem;
    max-width: 52ch;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-brand-text);
  }
</style>
