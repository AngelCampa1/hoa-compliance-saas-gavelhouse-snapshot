---
import "../../styles/global.css";
import BaseLayout from "../../layouts/base-layout.astro";
import SiteHeader from "../../components/site-header.astro";
import SiteFooter from "../../components/site-footer.astro";
import { siteConfig } from "../../config/site";
import { PRODUCT_GLOSSARY, PRODUCT_HELP_TOPICS } from "@boardstack/shared";

export function getStaticPaths() {
  return PRODUCT_HELP_TOPICS.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const glossary = PRODUCT_GLOSSARY.filter((entry) =>
  topic.glossaryTerms.includes(entry.term),
);
---

<BaseLayout
  title={`${topic.title} | ${siteConfig.name} Help`}
  description={topic.summary}
  canonicalUrl={`https://${siteConfig.domain}/help/${topic.slug}`}
  siteName={siteConfig.name}
  themeColor={siteConfig.theme.primary}
  theme={siteConfig.theme}
  fonts={siteConfig.theme.fonts}
  enableScrollReveal={false}
>
  <SiteHeader
    slot="header"
    siteName={siteConfig.name}
    navItems={siteConfig.nav?.items}
    ctaText={siteConfig.funnel.bofu.ctaText}
    ctaHref={siteConfig.funnel.bofu.ctaTarget}
  />

  <article class="mx-auto max-w-3xl px-4 py-16">
    <a
      href="/help/"
      class="inline-flex min-h-11 items-center text-sm font-medium text-[var(--color-brand-primary)] hover:underline"
    >
      Back to help
    </a>
    <p
      class="mt-6 text-sm font-semibold uppercase text-[var(--color-brand-primary)]"
    >
      Usually takes {topic.timeEstimate}
    </p>
    <h1
      class="mt-3 font-heading text-4xl font-bold leading-tight text-[var(--color-brand-text)]"
    >
      {topic.title}
    </h1>
    <p class="mt-4 text-lg leading-8 text-[var(--color-brand-muted)]">
      {topic.summary}
    </p>

    <div class="mt-10 space-y-6">
      {
        topic.sections.map((section) => (
          <section class="rounded-[var(--radius-md)] border border-[var(--color-neutral-200)] bg-[var(--surface-primary)] p-6">
            <h2 class="text-xl font-bold text-[var(--color-brand-text)]">
              {section.heading}
            </h2>
            <p class="mt-3 leading-7 text-[var(--color-brand-muted)]">
              {section.body}
            </p>
            {section.steps && (
              <ol class="mt-4 list-decimal space-y-2 pl-5 text-[var(--color-brand-muted)]">
                {section.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            )}
          </section>
        ))
      }
    </div>

    {
      glossary.length > 0 && (
        <section class="mt-10 rounded-[var(--radius-lg)] border border-[var(--color-neutral-200)] bg-[var(--surface-secondary)] p-6">
          <h2 class="text-xl font-bold text-[var(--color-brand-text)]">
            Words used in this guide
          </h2>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            {glossary.map((entry) => (
              <div>
                <h3 class="font-semibold text-[var(--color-brand-text)]">
                  {entry.term}
                </h3>
                <p class="mt-1 text-sm leading-6 text-[var(--color-brand-muted)]">
                  {entry.meaning}
                </p>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>

  <SiteFooter
    slot="footer"
    siteName={siteConfig.name}
    tagline={siteConfig.tagline}
    linkGroups={siteConfig.footer?.linkGroups}
    legalLinks={siteConfig.footer?.legalLinks}
  />
</BaseLayout>
