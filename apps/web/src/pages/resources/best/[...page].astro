---
import "../../../styles/global.css";
import { getCollection } from "astro:content";
import CategoryHub from "../../../hubs/category-hub.astro";
import PublicSignupCta from "../../../components/public-signup-cta.astro";
import { siteConfig } from "../../../config/site";
import { hubFaqs } from "../../../config/hub-faqs";
import {
  sortByUpdatedAtDesc,
  mapToContentItems,
} from "../../../lib/collections";
import type { GetStaticPathsOptions } from "astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const entries = await getCollection("listicles");
  const sorted = sortByUpdatedAtDesc(entries);
  const items = mapToContentItems(
    sorted,
    (e) => `/resources/best/${e.slug}/`,
    (e) => ({ category: e.data.category }),
  );
  return paginate(items, { pageSize: 12 });
}

const { page } = Astro.props;
---

<CategoryHub
  config={siteConfig}
  title="Software roundups"
  description="Ranked HOA software lists for self-managed boards."
  items={page.data}
  page={page}
  basePath="/resources/best"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Resources", href: "/resources/" },
    { label: "Software Roundups", href: "/resources/best/" },
  ]}
  faqs={hubFaqs["/resources/best"]}
>
  <section
    slot="cta"
    class="mt-8 py-10 text-center border-t border-[var(--color-neutral-100)]"
    id="signup"
  >
    <h2 class="text-2xl font-bold text-[var(--color-brand-text)] mb-2">
      Want help choosing?
    </h2>
    <p class="text-[var(--color-brand-muted)] mb-6 max-w-2xl mx-auto">
      Try Scale features first. Pick a plan later. Keep the 30-day money-back
      guarantee.
    </p>
    <PublicSignupCta sourcePage="/resources/best" buttonText="Start trial" />
  </section>
</CategoryHub>
