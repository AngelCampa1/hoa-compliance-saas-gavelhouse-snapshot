---
import "../../../styles/global.css";
import { getCollection } from "astro:content";
import CategoryHub from "../../../hubs/category-hub.astro";
import PublicSignupCta from "../../../components/public-signup-cta.astro";
import { siteConfig } from "../../../config/site";
import { hubFaqs } from "../../../config/hub-faqs";
import {
  sortByUpdatedAtDesc,
  mapToContentItems,
} from "../../../lib/collections";
import {
  getComparisonPath,
  isRoutableContentEntry,
} from "../../../lib/content-routing";
import type { GetStaticPathsOptions } from "astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const entries = (await getCollection("comparisons")).filter(
    isRoutableContentEntry,
  );
  const sorted = sortByUpdatedAtDesc(entries);
  const items = mapToContentItems(sorted, getComparisonPath);
  return paginate(items, { pageSize: 12 });
}

const { page } = Astro.props;
---

<CategoryHub
  config={siteConfig}
  title="Head-to-head comparisons"
  description="Compare HOA software by price, features, and fit."
  items={page.data}
  page={page}
  basePath="/compare/versus"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Compare", href: "/compare/" },
    { label: "Head-to-Head", href: "/compare/versus/" },
  ]}
  faqs={hubFaqs["/compare/versus"]}
>
  <section
    slot="cta"
    class="mt-8 py-10 text-center border-t border-[var(--color-neutral-100)]"
    id="signup"
  >
    <h2 class="text-2xl font-bold text-[var(--color-brand-text)] mb-2">
      Need help choosing?
    </h2>
    <p class="text-[var(--color-brand-muted)] mb-6 max-w-2xl mx-auto">
      Try Scale features first. Pick a plan later. Keep the 30-day money-back
      guarantee.
    </p>
    <PublicSignupCta sourcePage="/compare/versus" buttonText="Start trial" />
  </section>
</CategoryHub>
