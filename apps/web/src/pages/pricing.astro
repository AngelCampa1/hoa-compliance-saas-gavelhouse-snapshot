---
import "../styles/global.css";
import LandingLayout from "../layouts/landing-layout.astro";
import DocHeader from "../components/doc-header.astro";
import { siteConfig } from "../config/site";
import {
  getPricingFeatureRowsWithAvailability,
  type PricingTierId,
} from "../lib/pricing-feature-availability";
import { resolvePublicApiUrl } from "../lib/public-runtime-urls";
import {
  getAnnualLimitedOfferBillingText,
  getDiscountedDisplayPrice,
  getLimitedOfferUsageText,
  knowledgeBase,
  stripMonthlyPriceSuffix,
} from "@boardstack/shared";

const marketingKnowledge = knowledgeBase.marketing;
const faqs = marketingKnowledge.pricing.faqs;
const limitedOffer = marketingKnowledge.offer;
const publicApiUrl = resolvePublicApiUrl(import.meta.env.PUBLIC_API_URL);
const comparisonTierIds = [
  "starter",
  "growth",
  "scale",
] satisfies PricingTierId[];
const rows = getPricingFeatureRowsWithAvailability(
  marketingKnowledge.pricing.featureRows,
  marketingKnowledge.pricing.plans,
);
const staticOffer = {
  code: limitedOffer.annual.code,
  monthlyCode: limitedOffer.monthly.code,
  percentOff: limitedOffer.percentOff,
  badgeLabel: limitedOffer.badgeLabel,
  usageText: getLimitedOfferUsageText(),
};

function formatAnnualTotal(cents: number): string {
  return new Intl.NumberFormat("en-US", {
    currency: "USD",
    maximumFractionDigits: 0,
    style: "currency",
  }).format(cents / 100);
}

function formatMonthlyDisplay(cents: number): string {
  return formatAnnualTotal(cents);
}

const tiers = (siteConfig.pricingTiers ?? []).map((tier) => {
  const annualOfferDisplayPrice = getDiscountedDisplayPrice(
    tier.slug,
    "annual",
  );
  const annualOfferPrice = stripMonthlyPriceSuffix(annualOfferDisplayPrice);
  const monthlyOfferPrice = stripMonthlyPriceSuffix(
    getDiscountedDisplayPrice(tier.slug, "monthly"),
  );

  const annualListDisplayPrice = `${formatMonthlyDisplay(tier.annualPriceCents)}/mo`;
  const annualListPrice = stripMonthlyPriceSuffix(annualListDisplayPrice);

  return {
    ...tier,
    homes: tier.description,
    note: tier.complianceScope,
    featured: tier.highlighted,
    offerPrice: annualOfferPrice,
    annualOfferPrice,
    annualOfferBillingText: getAnnualLimitedOfferBillingText(
      tier.annualTotalPriceCents,
      annualOfferDisplayPrice,
    ),
    monthlyOfferPrice,
    monthlyBillingText: `billed monthly with ${limitedOffer.monthly.code}`,
    annualListDisplayPrice,
    annualListPrice,
    annualRenewalLine: `Then ${annualListDisplayPrice} billed annually after the first year`,
  };
});
const customOption = {
  name: "Portfolio",
  label: "Custom",
  body: "Run many communities or a management company? Email the builder.",
  href: "/contact/",
};
const comparisonTiers = comparisonTierIds.map((tierId) => {
  const tier = tiers.find((candidate) => candidate.slug === tierId);
  if (!tier) {
    throw new Error(`Missing pricing comparison tier: ${tierId}`);
  }
  return tier;
});
---

<LandingLayout
  config={siteConfig}
  canonicalPath="/pricing/"
  title="Gavelhouse pricing"
  description={`Flat HOA software pricing by community size with ${limitedOffer.annual.code}: ${limitedOffer.label} on annual Gavelhouse plans.`}
>
  <section class="b1-section">
    <div class="b1-container">
      <DocHeader
        kicker="PRICING"
        re="Flat prices for self-managed boards."
        meta={[
          { label: "BILLING", value: "Annual" },
          { label: "UNIT FEES", value: "None", tone: "resolved" },
        ]}
      />
      <h1 class="b1-h1">Flat pricing. No per-door fees.</h1>
      <p class="b1-body-lg">
        Try Gavelhouse first. Pick a plan later. Use {limitedOffer.annual.code}{
          " "
        }
        yearly or {limitedOffer.monthly.code} monthly for{" "}
        {limitedOffer.percentOff}% off your first year. Billing starts only if
        you keep using it after the trial.
      </p>
    </div>
  </section>

  <section class="b1-section b1-section--alt">
    <div class="b1-container">
      <div class="billing-toggle" aria-label="Billing cycle">
        <button type="button" data-billing-toggle="annual" aria-pressed="true">
          Annual
        </button>
        <button
          type="button"
          data-billing-toggle="monthly"
          aria-pressed="false"
        >
          Monthly
        </button>
      </div>
      <div class="b1-grid-3">
        {
          tiers.map((tier) => (
            <article
              class:list={[
                "b1-card pricing-card",
                tier.featured && "b1-card--hi",
              ]}
              data-annual-base-cents={tier.annualPriceCents}
              data-monthly-base-cents={tier.monthlyPriceCents}
              data-annual-total-base-cents={tier.annualTotalPriceCents}
              data-annual-base-display={formatMonthlyDisplay(
                tier.annualPriceCents,
              )}
              data-monthly-base-display={formatMonthlyDisplay(
                tier.monthlyPriceCents,
              )}
              data-annual-base-billing-text={`${formatAnnualTotal(
                tier.annualTotalPriceCents,
              )} per year; shown as ${formatMonthlyDisplay(
                tier.annualPriceCents,
              )}/mo`}
              data-monthly-base-billing-text="billed monthly"
            >
              {tier.featured && (
                <span class="b1-badge b1-badge--acc">Most common</span>
              )}
              <span class="offer-badge" data-offer-code={staticOffer.code}>
                {limitedOffer.annual.code} / {limitedOffer.badgeLabel}
              </span>
              <p class="tier-name">{tier.name}</p>
              <p class="tier-who-its-for">{tier.whoItsFor}</p>
              <p class="tier-outcome">
                <em>{tier.outcome}</em>
              </p>
              <div class="price-stack" data-billing-panel="annual">
                <span class="original-price">
                  {tier.annualListPrice}
                  <small>/mo</small>
                </span>
                <strong class="offer-price-annual">
                  {tier.annualOfferPrice}
                  <small>/mo</small>
                </strong>
                <span class="b1-small annual-billing-text">
                  {tier.homes} &middot; {tier.annualOfferBillingText}
                </span>
                <span class="b1-small renewal-line">
                  {tier.annualRenewalLine}
                </span>
              </div>
              <div class="price-stack" data-billing-panel="monthly" hidden>
                <strong class="offer-price-monthly">
                  {tier.monthlyOfferPrice}
                  <small>/mo</small>
                </strong>
                <span class="b1-small monthly-billing-text">
                  {tier.homes} &middot; {tier.monthlyBillingText}
                </span>
              </div>
              <p class="b1-body">{tier.note}</p>
              <p class="b1-small">
                <span data-offer-details-text>
                  Use{" "}
                  <strong data-offer-code-text>
                    {limitedOffer.annual.code}
                  </strong>{" "}
                  yearly or <strong>{limitedOffer.monthly.code}</strong> monthly
                  for {limitedOffer.percentOff}% off your first year.{" "}
                </span>
                <a href="/terms/#limited-offer">Offer details</a>.
              </p>
              <hr />
              <ul>
                {tier.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <p class="tier-not-ideal-for">
                <span class="tier-not-ideal-for__label">Not a fit if</span>
                {tier.notIdealFor}
              </p>
              <a
                class="b1-button b1-button--primary"
                href={marketingKnowledge.funnel.publicSignupUrl}
              >
                Start trial
              </a>
            </article>
          ))
        }
      </div>
      <div class="limited-offer-footnote" aria-label="Limited offer details">
        <p class="custom-pricing-option b1-small">
          <strong>{customOption.name}:</strong>
          {customOption.label}.{" "}
          {customOption.body}
          <a href={customOption.href}>Contact us</a>.
        </p>
        <p class="limited-offer-footnote__copy b1-small">
          <span data-offer-footnote-text>
            {staticOffer.code} applies to yearly plans.{" "}
            {staticOffer.monthlyCode} applies to monthly plans. Both are{" "}
            {staticOffer.percentOff}% off.
          </span>{" "}
          <a href="/terms/#limited-offer">Offer details</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="b1-section">
    <div class="b1-container">
      <p class="b1-eyebrow">Plan fit</p>
      <h2 class="b1-h2">Pick the plan that matches your board.</h2>
      <div
        class="b1-table-wrap section-table"
        tabindex="0"
        role="region"
        aria-label="Plan comparison table"
      >
        <table class="b1-table">
          <thead>
            <tr>
              <th>Capability</th>
              {comparisonTiers.map((tier) => <th>{tier.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr>
                  <td>{row.label}</td>
                  {comparisonTiers.map((tier) => (
                    <td>{row.featureAvailability[tier.slug] ? "Yes" : "--"}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="b1-section b1-section--alt">
    <div class="b1-container">
      <p class="b1-eyebrow">FAQ</p>
      <h2 class="b1-h2">Questions before your board votes.</h2>
      <div class="b1-card b1-faq faq-card">
        {
          faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p class="b1-body">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</LandingLayout>

<script is:inline define:vars={{ publicApiUrl, staticOffer }}>
  const billingToggles = Array.from(
    document.querySelectorAll("[data-billing-toggle]"),
  );
  const billingPanels = Array.from(
    document.querySelectorAll("[data-billing-panel]"),
  );

  function setBillingCycle(cycle) {
    for (const toggle of billingToggles) {
      toggle.setAttribute(
        "aria-pressed",
        String(toggle.dataset.billingToggle === cycle),
      );
    }

    for (const panel of billingPanels) {
      panel.hidden = panel.dataset.billingPanel !== cycle;
    }

    const billingMeta = document.querySelector('[data-doc-meta="billing"]');
    if (billingMeta) {
      billingMeta.textContent = cycle === "monthly" ? "Monthly" : "Annual";
    }
  }

  for (const toggle of billingToggles) {
    toggle.addEventListener("click", () => {
      setBillingCycle(toggle.dataset.billingToggle ?? "annual");
    });
  }

  const API_URL = publicApiUrl;

  async function hydrateLimitedOffer() {
    if (!API_URL) return;
    try {
      const res = await fetch(`${API_URL}/billing/limited-offer`);
      if (!res.ok) return;
      const data = await res.json();

      const annualOffer = data.offers?.find(
        (offer) => offer.cycle === "annual",
      );
      const monthlyOffer = data.offers?.find(
        (offer) => offer.cycle === "monthly",
      );
      const annualAvailable = annualOffer?.available === true;
      const monthlyAvailable = monthlyOffer?.available === true;
      const annualCode = annualAvailable ? annualOffer.code : staticOffer.code;
      const monthlyCode = monthlyAvailable ? monthlyOffer.code : null;
      const activeOffer = annualAvailable
        ? annualOffer
        : monthlyAvailable
          ? monthlyOffer
          : null;

      for (const badge of document.querySelectorAll(".offer-badge")) {
        badge.textContent = activeOffer
          ? `${activeOffer.code} / ${activeOffer.terms}`
          : "Limited offer unavailable";
      }

      function centsToDisplay(cents) {
        return `$${Math.ceil(cents / 100)}`;
      }

      for (const card of document.querySelectorAll(".pricing-card")) {
        const annualBase = Number(card.dataset.annualBaseCents ?? 0);
        const monthlyBase = Number(card.dataset.monthlyBaseCents ?? 0);
        const annualTotal = Number(card.dataset.annualTotalBaseCents ?? 0);

        if (annualBase) {
          const discounted = (annualBase * (100 - data.percentOff)) / 100;
          const annualDisplay = `${centsToDisplay(discounted)}/mo`;
          const annualEl = card.querySelector(".offer-price-annual");
          if (annualEl) {
            annualEl.innerHTML = annualAvailable
              ? `${centsToDisplay(discounted)}<small>/mo</small>`
              : `${card.dataset.annualBaseDisplay}<small>/mo</small>`;
          }
          const discountedTotal =
            Math.ceil((annualTotal * (100 - data.percentOff)) / 10000) * 100;
          const totalFormatted = new Intl.NumberFormat("en-US", {
            currency: "USD",
            maximumFractionDigits: 0,
            style: "currency",
          }).format(discountedTotal / 100);
          const billingEl = card.querySelector(".annual-billing-text");
          if (billingEl) {
            const txt = billingEl.textContent ?? "";
            billingEl.textContent = annualAvailable
              ? txt.replace(
                  /\$[\d,]+ per year with \w+; shown as about \$[\d,]+\/mo/,
                  `${totalFormatted} per year with ${annualCode}; shown as about ${annualDisplay}`,
                )
              : txt.replace(
                  /\$[\d,]+ per year with \w+; shown as about \$[\d,]+\/mo/,
                  card.dataset.annualBaseBillingText ?? "billed annually",
                );
          }
        }

        if (monthlyBase) {
          const discounted = (monthlyBase * (100 - data.percentOff)) / 100;
          const monthlyEl = card.querySelector(".offer-price-monthly");
          if (monthlyEl) {
            monthlyEl.innerHTML = monthlyAvailable
              ? `${centsToDisplay(discounted)}<small>/mo</small>`
              : `${card.dataset.monthlyBaseDisplay}<small>/mo</small>`;
          }
          const monthlyBillingEl = card.querySelector(".monthly-billing-text");
          if (monthlyBillingEl) {
            const homes = monthlyBillingEl.textContent?.split("·")[0]?.trim();
            monthlyBillingEl.textContent = `${homes} · ${
              monthlyAvailable
                ? `billed monthly with ${monthlyCode}`
                : (card.dataset.monthlyBaseBillingText ?? "billed monthly")
            }`;
          }
        }
      }

      for (const el of document.querySelectorAll("[data-offer-code-text]")) {
        el.textContent = annualCode;
      }
      const detailText =
        annualAvailable && monthlyAvailable
          ? `Use ${annualCode} yearly or ${monthlyCode} monthly for ${staticOffer.percentOff}% off your first year.`
          : annualAvailable
            ? `Use ${annualCode} yearly for ${staticOffer.percentOff}% off your first year.`
            : monthlyAvailable
              ? `Use ${monthlyCode} monthly for ${staticOffer.percentOff}% off your first year.`
              : "This limited offer is not available right now.";
      for (const el of document.querySelectorAll("[data-offer-details-text]")) {
        el.textContent = detailText;
      }
      const footnoteText =
        annualAvailable && monthlyAvailable
          ? `Use ${annualCode} yearly or ${monthlyCode} monthly for ${data.percentOff}% off your first year.`
          : annualAvailable
            ? `Use ${annualCode} yearly for ${data.percentOff}% off your first year.`
            : monthlyAvailable
              ? `Use ${monthlyCode} monthly for ${data.percentOff}% off your first year.`
              : "Limited offer discounts are not available right now.";
      for (const el of document.querySelectorAll(
        "[data-offer-footnote-text]",
      )) {
        el.textContent = footnoteText;
      }
      if (!annualAvailable && monthlyAvailable) {
        setBillingCycle("monthly");
      }
    } catch {
      // Silently fall back to static limited-offer content.
    }
  }

  hydrateLimitedOffer();
</script>

<style>
  .billing-toggle {
    display: flex;
    gap: 4px;
    border: 1px solid var(--hairline);
    border-radius: 9999px;
    background: var(--paper-0);
    padding: 4px;
    margin-bottom: 22px;
    width: 100%;
  }

  @media (min-width: 40rem) {
    .billing-toggle {
      display: inline-flex;
      width: auto;
    }
  }

  .billing-toggle button {
    flex: 1;
    min-height: 44px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: var(--ink-1);
    cursor: pointer;
    padding: 9px 14px;
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 40rem) {
    .billing-toggle button {
      flex: none;
      min-width: 92px;
      font-size: 12px;
    }
  }

  .billing-toggle button[aria-pressed="true"] {
    background: var(--ink-0);
    color: var(--paper-0);
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .offer-badge {
    width: fit-content;
    border: 1px solid var(--accent);
    border-radius: 5px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    padding: 4px 8px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tier-name {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tier-who-its-for {
    margin: 0;
    color: var(--ink-2);
    font-size: 13px;
  }

  .tier-outcome {
    margin: 0;
    color: var(--ink-1);
    font-size: 13px;
    font-style: italic;
  }

  .tier-not-ideal-for {
    margin: 0;
    color: var(--ink-2);
    font-size: 12px;
    line-height: 1.5;
  }

  .tier-not-ideal-for__label {
    display: block;
    margin-bottom: 2px;
    color: var(--ink-1);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .price-stack {
    display: grid;
    gap: 5px;
  }

  .original-price {
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: 16px;
    text-decoration: line-through;
  }

  .pricing-card strong {
    font-family: var(--serif);
    font-size: clamp(2rem, 7vw, 2.75rem);
    line-height: 1;
  }

  .pricing-card small {
    font-family: var(--sans);
    font-size: 18px;
  }

  .pricing-card hr {
    width: 100%;
    border: 0;
    border-top: 1px solid var(--hairline);
  }

  .pricing-card ul {
    display: grid;
    gap: 9px;
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
  }

  .pricing-card li::before {
    content: "•";
    margin-right: 8px;
    color: var(--accent);
  }

  .pricing-card .b1-button {
    margin-top: auto;
  }

  .section-table,
  .faq-card {
    margin-top: 24px;
  }

  .limited-offer-footnote {
    margin-top: 28px;
    max-width: 620px;
  }

  .custom-pricing-option {
    margin: 0 0 10px;
    color: var(--ink-1);
  }

  .limited-offer-footnote__copy {
    margin-bottom: 8px;
    color: var(--ink-2);
  }
</style>
