{
  "name": "@boardstack/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3061",
    "build": "pnpm run audit:seo && pnpm run generate:pdfs && tsx scripts/verify-lead-magnet-pdfs.ts && astro build && tsx scripts/verify-lead-magnet-pdfs.ts --dist-absent",
    "preview": "astro preview --port 3061",
    "deploy": "node ../../scripts/run-deploy-sequence.mjs web",
    "deploy:upload": "wrangler deploy",
    "lint": "pnpm exec eslint .",
    "typecheck": "astro check",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "generate:pdfs": "tsx scripts/generate-pdfs.ts",
    "upload:lead-magnet-pdfs": "tsx scripts/upload-lead-magnet-pdfs-to-r2.ts",
    "verify:lead-magnet-r2": "tsx scripts/verify-lead-magnet-r2.ts",
    "audit:seo": "tsx scripts/run-public-seo-audit.ts",
    "normalize:seo": "tsx scripts/normalize-public-seo-content.ts",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12",
    "@astrojs/react": "^4",
    "@astrojs/rss": "^4",
    "@astrojs/sitemap": "^3",
    "@boardstack/design": "workspace:*",
    "@boardstack/shared": "workspace:*",
    "@sentry/browser": "^10.46.0",
    "astro": "^5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@sentry/vite-plugin": "^5.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.3",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.0.2",
    "marked": "^18.0.2",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.42.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.7",
    "vitest": "^4.1.3",
    "wrangler": "^4.85.0"
  }
}
